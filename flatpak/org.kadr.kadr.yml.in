app-id: org.kadr.kadr
runtime: org.gnome.Platform
runtime-version: '51'
sdk: org.gnome.Sdk
command: kadr
finish-args:
  - --share=ipc
  - --socket=wayland
  - --socket=fallback-x11
  - --device=dri
modules:
  - name: kadr
    buildsystem: simple
    build-commands:
      - install -Dm755 kadr /app/bin/kadr
      - install -Dm644 org.kadr.kadr.desktop /app/share/applications/org.kadr.kadr.desktop
      - install -Dm644 org.kadr.kadr.svg /app/share/icons/hicolor/scalable/apps/org.kadr.kadr.svg
      - install -Dm644 org.kadr.kadr.metainfo.xml /app/share/metainfo/org.kadr.kadr.metainfo.xml
      - install -Dm644 locale/en/LC_MESSAGES/kadr.mo /app/share/locale/en/LC_MESSAGES/kadr.mo
    sources:
      - type: archive
        url: SOURCE_ARCHIVE_URL
        sha256: SOURCE_ARCHIVE_SHA256
        strip-components: 1
