        d = Adw.AlertDialog(heading='Zastąpić oryginalne?',
                            body=f'Obrazy z kadrem ({nc}) zostaną zastąpione przyciętymi wersjami — każdy wg '
                                 'swojego kadru. Kopie oryginałów zostaną zachowane, '
                                 'więc możesz to cofnąć przyciskiem „Cofnij”.')
        fb = [t for t in self.thumbs if self.crop_of(t)
              and not WRITABLE.get(os.path.splitext(t.path)[1].lower().lstrip('.'))]
        if fb:
            exts = ', '.join(sorted({os.path.splitext(t.path)[1].lower() or '(brak)' for t in fb}))
            d.set_body(d.get_body() + f'\n\nUwaga: dla {len(fb)} z tych obrazów system nie obsługuje zapisu '
                       f'w ich formacie ({exts}). Nie da się ich zastąpić — kadr zapisze się jako nowy '
                       'plik PNG obok oryginału, a oryginał zostanie bez zmian. '
