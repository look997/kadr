def valid_crop(v):
    return (isinstance(v, list) and len(v) == 4 and all(isinstance(i, int) for i in v)
            and v[0] >= 0 and v[1] >= 0 and v[2] > 0 and v[3] > 0)


def valid_ref(v):
    return isinstance(v, list) and len(v) == 2 and all(isinstance(i, int) and i > 0 for i in v)


def parse_groups(raw):
    """Kadry indywidualne (#N) z JSON-a: klucze tekstowe -> liczby, tylko poprawne kadry."""
    out = {}
    if isinstance(raw, dict):
        for k, v in raw.items():
            try:
                g = int(k)
            except (TypeError, ValueError):
                continue
            if g >= 2 and (v is None or valid_crop(v)):
                out[g] = v
    return out


def parse_refs(raw):
    """Wzorce kadrów: numer grupy (0 = kadr ogólny) -> rozmiar obrazu, na którym kadr zaznaczono."""
    out = {}
    if isinstance(raw, dict):
        for k, v in raw.items():
            try:
                g = int(k)
            except (TypeError, ValueError):
                continue
            if g >= 0 and valid_ref(v):
                out[g] = tuple(v)
    return out


def parse_img_groups(raw, groups):
    out = {}
    if isinstance(raw, dict):
        for k, v in raw.items():
            if isinstance(k, str) and isinstance(v, int) and v in groups:
                out[k] = v
    return out


def parse_view(raw):
    """Zapamiętany widok: obraz, zoom (względem dopasowania) i środek widoku jako ułamki obrazu."""
    if not isinstance(raw, dict) or not isinstance(raw.get('path'), str):
        return None
    try:
        z, cx, cy = float(raw['zoom']), float(raw['cx']), float(raw['cy'])
    except (KeyError, TypeError, ValueError):
        return None
    if not all(math.isfinite(v) for v in (z, cx, cy)) or z <= 1.0:
        return None
    return {'path': raw['path'], 'zoom': z, 'cx': min(max(cx, 0.0), 1.0), 'cy': min(max(cy, 0.0), 1.0)}


def load_state():
    """Stan sesji: kadr, grupy kadrów indywidualnych, obrazy, aktywny obraz, schemat, panel, rozmiary."""
    st = {'crop': None, 'dirty': False, 'images': [], 'current': None, 'scheme': DEFAULT_SCHEME,
          'groups': {}, 'img_groups': {}, 'refs': {}, 'cleared': None, 'panel': 'bottom', 'rows': 1,
          'side_w': SIDE_DEFAULT, 'win_w': WIN_W, 'win_h': WIN_H, 'maximized': False, 'view': None}
    for p in (STATE, OLD_STATE):
        try:
            with open(p) as f:
                d = json.load(f)
        except Exception:
            continue
        if not isinstance(d, dict):
            continue
        if valid_crop(d.get('crop')):
            st['crop'] = d['crop']
        if isinstance(d.get('images'), list):
            st['images'] = [i for i in d['images'] if isinstance(i, str)]
        if isinstance(d.get('current'), str):
            st['current'] = d['current']
        if isinstance(d.get('scheme'), str) and d['scheme'].strip():
            # starsza składnia {nazwa}/{nr} -> [nazwa]/[nr]
            st['scheme'] = d['scheme'].replace('{nazwa}', '[nazwa]').replace('{nr}', '[nr]')
        if d.get('panel') in PANEL_MODES:
            st['panel'] = d['panel']
        if isinstance(d.get('rows'), int) and 1 <= d['rows'] <= 12:
            st['rows'] = d['rows']
        if isinstance(d.get('side_w'), int) and SIDE_MIN <= d['side_w'] <= 2000:
            st['side_w'] = d['side_w']
        for k, lo in (('win_w', 400), ('win_h', 300)):
            if isinstance(d.get(k), int) and lo <= d[k] <= 20000:
                st[k] = d[k]
        st['maximized'] = d.get('maximized') is True
        st['view'] = parse_view(d.get('view'))
        st['groups'] = parse_groups(d.get('groups'))
        st['refs'] = parse_refs(d.get('refs'))
        st['img_groups'] = parse_img_groups(d.get('img_groups'), st['groups'])
        # lista wyczyszczona przyciskiem „Wyczyść” — zostaje do przywrócenia także po restarcie
        c = d.get('cleared')
        if isinstance(c, dict) and isinstance(c.get('paths'), list):
            paths = [p for p in c['paths'] if isinstance(p, str)]
            if paths:
                cg = parse_groups(c.get('groups'))
                st['cleared'] = {'paths': paths,
                                 'current': c['current'] if isinstance(c.get('current'), str) else None,
                                 'groups': cg, 'refs': parse_refs(c.get('refs')),
                                 'img_groups': parse_img_groups(c.get('img_groups'), cg),
                                 'dirty': c.get('dirty') is True}
        st['dirty'] = d.get('dirty') is True and bool(st['crop'] or st['groups'])
        break
    return st


def save_state(st):
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        tmp = STATE + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(st, f)
        os.replace(tmp, STATE)
    except OSError:
        pass


def undo_load():
    try:
        with open(UNDO_MAN) as f:
            m = json.load(f)
        if m.get('items'):
            return m
    except Exception:
        pass
    return None


def undo_clear():
    shutil.rmtree(UNDO_DIR, ignore_errors=True)


def purge_pasted(keep=(), days=7):
    """Usuwa stare obrazy wklejone ze schowka (poza tymi, które są w zapamiętanej sesji)."""
    now = time.time()
    try:
        for n in os.listdir(PASTE_DIR):
            p = os.path.join(PASTE_DIR, n)
            if p in keep:
                continue
            if now - os.path.getmtime(p) > days * 86400:
                os.remove(p)
    except OSError:
        pass


