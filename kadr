    cr.line_to(14.5, 1.5)
    cr.line_to(14.5, 10.5)
    cr.line_to(10.5, 10.5)
    cr.stroke()
    cr.rectangle(1.5, 5.5, 9, 9)    # przednia kartka
    cr.stroke()
    cr.move_to(3.7, 8.3)        # „>_”
    cr.line_to(5.5, 10)
    cr.line_to(3.7, 11.7)
    cr.stroke()
    cr.move_to(6.5, 12)
    cr.line_to(8.3, 12)
    cr.stroke()


class Grip(Gtk.Box):
    """Uchwyt do ręcznej zmiany rozmiaru panelu.

    Przesunięcie liczone jest we współrzędnych okna, bo sam uchwyt się przesuwa
    razem ze zmianą rozmiaru (inaczej drgałby przy przeciąganiu)."""

    def __init__(self, vertical, win, begin, move):
        super().__init__()
        self.add_css_class('grip')
        self.top, self.cb_begin, self.cb_move = win, begin, move
        self.start, self.p0, self.v0 = (0, 0), (0, 0), None
        if vertical:       # pionowy pasek -> zmiana szerokości
            self.set_size_request(GRIP_W, -1)
            self.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL, halign=Gtk.Align.CENTER,
                                      vexpand=True))
            self.set_cursor_from_name('col-resize')
            self.set_tooltip_text('Przeciągnij, aby zmienić szerokość panelu')
        else:              # poziomy pasek -> zmiana wysokości
            self.set_size_request(-1, GRIP_W)
            self.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL, valign=Gtk.Align.CENTER,
                                      hexpand=True))
            self.set_cursor_from_name('row-resize')
            self.set_tooltip_text('Przeciągnij, aby zmienić wysokość panelu (liczbę wierszy miniatur)')
        g = Gtk.GestureDrag()
        g.set_button(1)
        g.connect('drag-begin', self.on_begin)
        g.connect('drag-update', self.on_update)
        g.connect('drag-end', self.on_end)
        self.add_controller(g)

    def win_pos(self, dx, dy):
        sx, sy = self.start
        ok, p = self.compute_point(self.top, Graphene.Point().init(sx + dx, sy + dy))
        return (p.x, p.y) if ok else (sx + dx, sy + dy)

    def on_begin(self, g, x, y):
        self.start = (x, y)
        self.p0 = self.win_pos(0, 0)
        self.v0 = self.cb_begin()
        self.add_css_class('drag')

    def on_update(self, g, dx, dy):
        x, y = self.win_pos(dx, dy)
        self.cb_move(self.v0, x - self.p0[0], y - self.p0[1])

    def on_end(self, g, dx, dy):
        self.remove_css_class('drag')


class CropArea(Gtk.DrawingArea):
    __gsignals__ = {
        'changed': (GObject.SignalFlags.RUN_FIRST, None, ()),
        'zoom-changed': (GObject.SignalFlags.RUN_FIRST, None, ()),
        'open-request': (GObject.SignalFlags.RUN_FIRST, None, ()),
        'edit-end': (GObject.SignalFlags.RUN_FIRST, None, ()),
    }

    def __init__(self):
        super().__init__(hexpand=True, vexpand=True, content_width=CANVAS_MIN, content_height=200, focusable=True)
        self.add_css_class('canvas')
        self.pix = self.scaled = self.sel = self.key = self.op = None
        self.want = None            # widok do zastosowania, gdy pole dostanie rozmiar
        self.color, self.label = ACCENT, None
        self.lp = None              # punkt obrazu pokazywany w lupce (x, y) albo None
        self.lc = None              # róg pola, w którym stoi lupka
        self.lt = 0                 # timer chowania lupki po zmianie kadru polem liczbowym
        self.status = None          # tekst na pustym polu (np. „Ładowanie obrazów…”)
        self.zoom, self.panx, self.pany = 1.0, 0.0, 0.0
        self.mx = self.my = 0
        self.inside = False
        self.pan_ok = False
        self.set_draw_func(self.draw)
        self.set_cursor_from_name('pointer')

        click = Gtk.GestureClick()
        click.set_button(1)
        click.connect('released', lambda g, n, x, y: None if self.pix else self.emit('open-request'))
        self.add_controller(click)

        drag = Gtk.GestureDrag()
        drag.set_button(1)
        drag.connect('drag-begin', self.on_begin)
        drag.connect('drag-update', self.on_update)
        drag.connect('drag-end', self.on_end)
        self.add_controller(drag)

        pan = Gtk.GestureDrag()
        pan.set_button(0)
        pan.connect('drag-begin', self.pan_begin)
        pan.connect('drag-update', self.pan_update)
        pan.connect('drag-end', self.pan_end)
        self.add_controller(pan)

        mot = Gtk.EventControllerMotion()
        mot.connect('motion', self.on_motion)
        mot.connect('leave', lambda c: setattr(self, 'inside', False))
        self.add_controller(mot)

        sc = Gtk.EventControllerScroll.new(Gtk.EventControllerScrollFlags.VERTICAL)
        sc.connect('scroll', self.on_scroll)
        self.add_controller(sc)

        self.connect('resize', self.on_resize)

    def set_drop_hover(self, on):
        if on:
            self.add_css_class('drop-hover')
        else:
            self.remove_css_class('drop-hover')

    # --- geometria i zoom ---
    @property
    def size(self):
        return (self.pix.get_width(), self.pix.get_height()) if self.pix else (0, 0)

    def base(self):
        pw, ph = self.size
        W, H, pad = self.get_width(), self.get_height(), 8
        return max(min((W - 2 * pad) / pw, (H - 2 * pad) / ph), 0.01)

    def scale(self):
        return self.base() * self.zoom

    def clamp_pan(self):
        pw, ph = self.size
        s = self.scale()
        mx = max(0, (pw * s - self.get_width()) / 2)
        my = max(0, (ph * s - self.get_height()) / 2)
        self.panx = min(max(self.panx, -mx), mx)
        self.pany = min(max(self.pany, -my), my)

    def geom(self):
        pw, ph = self.size
        s = self.scale()
        W, H = self.get_width(), self.get_height()
        return s, (W - pw * s) / 2 + self.panx, (H - ph * s) / 2 + self.pany

    def zoom_to(self, z, cx=None, cy=None):
        """Zoom względem dopasowania do okna; punkt pod (cx, cy) zostaje w miejscu."""
        if not self.pix:
            return
        W, H = self.get_width(), self.get_height()
        cx = W / 2 if cx is None else cx
        cy = H / 2 if cy is None else cy
        s0 = self.base()
        z = min(max(z, 1.0), max(1.0, MAX_SCALE / s0))
        s, ox, oy = self.geom()
        ix, iy = (cx - ox) / s, (cy - oy) / s
        pw, ph = self.size
        s2 = s0 * z
        self.zoom = z
        self.panx = cx - ix * s2 - (W - pw * s2) / 2
        self.pany = cy - iy * s2 - (H - ph * s2) / 2
        if z <= 1.0:
            self.panx = self.pany = 0.0
        self.clamp_pan()
        self.queue_draw()
        self.emit('zoom-changed')

    def zoom_by(self, f, at_pointer=False):
        if at_pointer and self.inside:
            self.zoom_to(self.zoom * f, self.mx, self.my)
        else:
            self.zoom_to(self.zoom * f)

    def view_state(self):
        """(zoom, cx, cy): zoom względem dopasowania i punkt obrazu w środku pola (ułamki jego rozmiaru)."""
        if not self.pix:
            return None
        pw, ph = self.size
        s, ox, oy = self.geom()
        return self.zoom, (self.get_width() / 2 - ox) / s / pw, (self.get_height() / 2 - oy) / s / ph

    def set_view(self, z, cx, cy):
        """Przywraca zoom i przesunięcie; jeśli pole nie ma jeszcze rozmiaru, czeka na pierwszy resize."""
        if not self.pix:
            return
        W, H = self.get_width(), self.get_height()
        if W <= 16 or H <= 16:
            self.want = (z, cx, cy)
            return
        pw, ph = self.size
        s0 = self.base()
        z = min(max(z, 1.0), max(1.0, MAX_SCALE / s0))
        s = s0 * z
        self.zoom = z
        self.panx = W / 2 - cx * pw * s - (W - pw * s) / 2
        self.pany = H / 2 - cy * ph * s - (H - ph * s) / 2
        if z <= 1.0:
            self.panx = self.pany = 0.0
        self.clamp_pan()
        self.queue_draw()
        self.emit('zoom-changed')

    def on_scroll(self, c, dx, dy):
        self.zoom_to(self.zoom * 1.2 ** (-dy), self.mx, self.my)
        return True

    def on_resize(self, area, w, h):
        if self.pix and self.want and w > 16 and h > 16:
            want, self.want = self.want, None
            self.set_view(*want)
            return
        if self.pix:
            self.clamp_pan()
        self.emit('zoom-changed')

    def on_motion(self, c, x, y):
        self.mx, self.my = x, y
        self.inside = True
        if not self.pan_ok:
            self.set_cursor_from_name(self.cursor(self.hit(x, y)) if self.pix else 'pointer')

    def pan_begin(self, g, x, y):
        self.pan_ok = self.pix is not None and g.get_current_button() in (2, 3)
        self.pan0 = (self.panx, self.pany)
        if self.pan_ok:
            self.set_cursor_from_name('grabbing')

    def pan_update(self, g, dx, dy):
        if not self.pan_ok:
            return
        self.panx, self.pany = self.pan0[0] + dx, self.pan0[1] + dy
        self.clamp_pan()
        self.queue_draw()

    def pan_end(self, g, dx, dy):
        if self.pan_ok:
            self.pan_ok = False
            self.set_cursor_from_name(None)
            self.emit('zoom-changed')   # koniec przesuwania — zapisz widok

    # --- obraz ---
    def set_pix(self, pix):
        """Zmienia wyświetlany obraz — kadr (self.sel) ustawia okno."""
        self.pix, self.key, self.want = pix, None, None
        self.loupe_off()
        self.zoom, self.panx, self.pany = 1.0, 0.0, 0.0
        self.set_cursor_from_name(None)
        self.queue_draw()
        self.emit('zoom-changed')

    def clear(self):
        self.pix = self.scaled = self.key = self.want = None
        self.loupe_off()
        self.zoom, self.panx, self.pany = 1.0, 0.0, 0.0
        self.set_cursor_from_name('pointer')
        self.queue_draw()
        self.emit('zoom-changed')

    def vis(self):
        """Część kadru widoczna na bieżącym obrazie (x0, y0, x1, y1) albo None."""
        if not self.sel or not self.pix:
            return None
        pw, ph = self.size
        X, Y, w, h = self.sel
        x0, y0, x1, y1 = max(X, 0), max(Y, 0), min(X + w, pw), min(Y + h, ph)
        return (x0, y0, x1, y1) if x1 > x0 and y1 > y0 else None

    def to_img(self, x, y):
        s, ox, oy = self.geom()
        pw, ph = self.size
        return min(max((x - ox) / s, 0), pw), min(max((y - oy) / s, 0), ph)

    def draw(self, area, cr, W, H):
        if not self.pix:
            if self.status:
                cr.set_source_rgb(1, 1, 1)
                cr.set_font_size(16)
                center_text(cr, self.status, W, H / 2)
                return
            y = H / 2 - (30 + 20 * len(HINT)) / 2 + 16
            cr.set_source_rgb(1, 1, 1)
            cr.set_font_size(16)
            center_text(cr, 'Otwórz obrazy, aby zacząć', W, y)
            cr.set_source_rgb(*DIM)
            cr.set_font_size(12)
            y += 12
            for t in HINT:
                y += 20
                center_text(cr, t, W, y)
            return
        pw, ph = self.size
        s, ox, oy = self.geom()
        # rysujemy tylko widoczny fragment obrazu — wynik jest ograniczony rozmiarem widgetu
        vx0, vy0 = max(0, math.floor(-ox / s)), max(0, math.floor(-oy / s))
        vx1, vy1 = min(pw, math.ceil((W - ox) / s)), min(ph, math.ceil((H - oy) / s))
        if vx1 > vx0 and vy1 > vy0:
            dw, dh = max(1, round((vx1 - vx0) * s)), max(1, round((vy1 - vy0) * s))
            interp = GdkPixbuf.InterpType.NEAREST if s >= 3 else GdkPixbuf.InterpType.BILINEAR
            key = (vx0, vy0, vx1, vy1, dw, dh, interp)
            if self.key != key:
                sub = self.pix.new_subpixbuf(vx0, vy0, vx1 - vx0, vy1 - vy0)
                self.scaled = sub.scale_simple(dw, dh, interp)
                self.key = key
            Gdk.cairo_set_source_pixbuf(cr, self.scaled, ox + vx0 * s, oy + vy0 * s)
            cr.paint()
        shade(cr, ox, oy, pw * s, ph * s, self.sel, s, self.color, self.label, 13, (W, H), True,
              dark=self.op is None and self.lp is None)
        if self.lp is not None:
            ax, ay = ox + self.lp[0] * s, oy + self.lp[1] * s
            cr.arc(ax, ay, 3.5, 0, 2 * math.pi)
            cr.set_source_rgb(0, 0, 0)
            cr.fill()
            cr.arc(ax, ay, 2, 0, 2 * math.pi)
            cr.set_source_rgb(1, 1, 1)
            cr.fill()
            self.draw_loupe(cr, W, H, s, ox, oy)

    # --- lupka ---
    def loupe_off(self):
        if self.lt:
            GLib.source_remove(self.lt)
            self.lt = 0
        self.lc = None
        if self.lp is not None:
            self.lp = None
            self.queue_draw()

    def loupe_tick(self):
        self.lt = 0
        if not self.op:
            self.loupe_off()
        return GLib.SOURCE_REMOVE

    def loupe_edge(self, k):
        """Lupka na krawędzi kadru zmienionej polem liczbowym (x/y/w/h) — chowa się sama po chwili."""
        v = self.vis()
        if not v:
            return
        x0, y0, x1, y1 = v
        self.lp = {'x': (x0, (y0 + y1) / 2), 'y': ((x0 + x1) / 2, y0),
                   'w': (x1, (y0 + y1) / 2), 'h': ((x0 + x1) / 2, y1)}[k]
        if self.lt:
            GLib.source_remove(self.lt)
        self.lt = GLib.timeout_add(LOUPE_HOLD, self.loupe_tick)
        self.queue_draw()

    def loupe_pt(self, dx, dy):
        """Punkt obrazu, który właśnie ruszasz: narożnik, punkt na krawędzi albo najbliższy róg przy przesuwaniu."""
        X, Y, w, h = self.sel
        px, py = self.to_img(self.p0[0] + dx, self.p0[1] + dy)
        if self.op == 'new':
            ax, ay = self.anchor
            return (X if px < ax else X + w), (Y if py < ay else Y + h)
        if self.op == 'move':
            right, bottom = self.corner
            return X + (w if right else 0), Y + (h if bottom else 0)
        l, r, t, b = self.op
        return ((X if l else X + w if r else min(max(px, X), X + w)),
                (Y if t else Y + h if b else min(max(py, Y), Y + h)))

    def draw_loupe(self, cr, W, H, s, ox, oy):
        """Koło z powiększonym fragmentem obrazu wokół self.lp. Stoi w rogu pola najdalszym od tego
        punktu i przeskakuje do innego rogu dopiero, gdy punkt się do niego zbliży."""
        px, py = self.lp
        pw, ph = self.size
        R = min(LOUPE_R, max(40, min(W, H) / 3))    # w małym polu kółko się zmniejsza, żeby nie zasłaniało go całego
        L = max(LOUPE_ZOOM, s * 1.5)
        m = R + LOUPE_M
        pos = [(m, m), (W - m, m), (m, H - m), (W - m, H - m)]
        ax, ay = ox + px * s, oy + py * s
        if self.lc is None or math.hypot(ax - pos[self.lc][0], ay - pos[self.lc][1]) < R + 56:
            self.lc = max(range(4), key=lambda i: math.hypot(ax - pos[i][0], ay - pos[i][1]))
        lx, ly = pos[self.lc]
        x0, y0 = max(0, math.floor(px - R / L) - 1), max(0, math.floor(py - R / L) - 1)
        x1, y1 = min(pw, math.ceil(px + R / L) + 1), min(ph, math.ceil(py + R / L) + 1)
        cr.save()
        cr.arc(lx, ly, R, 0, 2 * math.pi)
        cr.clip_preserve()
        cr.set_source_rgb(.1, .1, .1)
        cr.fill()
        if x1 > x0 and y1 > y0:
            sub = self.pix.new_subpixbuf(x0, y0, x1 - x0, y1 - y0)
            cr.save()
            cr.translate(lx + (x0 - px) * L, ly + (y0 - py) * L)
            cr.scale(L, L)
            Gdk.cairo_set_source_pixbuf(cr, sub, 0, 0)
            cr.get_source().set_filter(cairo.Filter.NEAREST)
            cr.paint()
            cr.restore()
        if self.sel:
            X, Y, w, h = self.sel
            sx0, sy0 = lx + (X - px) * L, ly + (Y - py) * L
            sx1, sy1 = lx + (X + w - px) * L, ly + (Y + h - py) * L
            cr.set_source_rgb(*self.color)
            cr.set_line_width(2)
            cr.rectangle(sx0, sy0, sx1 - sx0, sy1 - sy0)
            cr.stroke()
        cr.arc(lx, ly, 3.5, 0, 2 * math.pi)
        cr.set_source_rgb(0, 0, 0)
        cr.fill()
        cr.arc(lx, ly, 2, 0, 2 * math.pi)
        cr.set_source_rgb(1, 1, 1)
        cr.fill()
        cr.restore()
        cr.arc(lx, ly, R, 0, 2 * math.pi)
        cr.set_source_rgba(0, 0, 0, .6)
        cr.set_line_width(5)
        cr.stroke_preserve()
        cr.set_source_rgb(1, 1, 1)
        cr.set_line_width(2)
        cr.stroke()

    # --- kadrowanie myszą ---
    def hit(self, x, y):
        if not self.sel:
            return 'new'
        s, ox, oy = self.geom()
        X, Y, w, h = self.sel
        l, t, r, b = ox + X * s, oy + Y * s, ox + (X + w) * s, oy + (Y + h) * s
        m = 8
        if not (l - m <= x <= r + m and t - m <= y <= b + m):
            return 'new'
        el = abs(x - l) <= m and abs(x - l) <= abs(x - r)
        er = abs(x - r) <= m and not el
        et = abs(y - t) <= m and abs(y - t) <= abs(y - b)
        eb = abs(y - b) <= m and not et
        if el or er or et or eb:
            return (el, er, et, eb)
        return 'move' if l <= x <= r and t <= y <= b else 'new'

    @staticmethod
    def cursor(op):
        if op == 'new':
            return 'crosshair'
        if op == 'move':
            return 'move'
        l, r, t, b = op
        return ('n' if t else 's' if b else '') + ('w' if l else 'e' if r else '') + '-resize'

    def on_begin(self, g, x, y):
        self.grab_focus()
        self.loupe_off()
        self.op = self.hit(x, y) if self.pix else None
        self.p0 = (x, y)
        if self.op == 'new':
            self.anchor = self.to_img(x, y)
        elif self.op:
            self.sel0 = list(self.sel)
            if self.op == 'move':
                ix, iy = self.to_img(x, y)
                X, Y, w, h = self.sel
                self.corner = (ix > X + w / 2, iy > Y + h / 2)     # róg kadru najbliższy chwytu — jego pokazuje lupka

    def on_update(self, g, dx, dy):
        if not self.op:
            return
        pw, ph = self.size
        s = self.geom()[0]
        if self.op == 'new':
            (ax, ay), (px, py) = self.anchor, self.to_img(self.p0[0] + dx, self.p0[1] + dy)
            self.sel = [round(min(ax, px)), round(min(ay, py)), round(abs(ax - px)), round(abs(ay - py))]
        else:
            X, Y, w, h = self.sel0
            di, dj = round(dx / s), round(dy / s)
            if self.op == 'move':
                self.sel = [min(max(X + di, 0), max(pw - w, X)), min(max(Y + dj, 0), max(ph - h, Y)), w, h]
            else:
                l, r, t, b = self.op
                x0, y0, x1, y1 = X, Y, X + w, Y + h
                if l: x0 = min(max(x0 + di, 0), x1 - 1)
                if r: x1 = max(min(x1 + di, max(pw, X + w)), x0 + 1)
                if t: y0 = min(max(y0 + dj, 0), y1 - 1)
                if b: y1 = max(min(y1 + dj, max(ph, Y + h)), y0 + 1)
                self.sel = [x0, y0, x1 - x0, y1 - y0]
        self.lp = self.loupe_pt(dx, dy)
        self.queue_draw()
        self.emit('changed')

    def on_end(self, g, dx, dy):
        self.op = None
        self.lp = self.lc = None
        if self.sel and (self.sel[2] < 1 or self.sel[3] < 1):
            self.sel = None
            self.emit('changed')
        self.queue_draw()
        self.emit('edit-end')


class Thumb(Gtk.DrawingArea):
    def __init__(self, path, get_info):
        super().__init__(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER,
                         tooltip_text=os.path.basename(path))
        self.path, self.get_info = path, get_info
        self.name = os.path.basename(path)
        self.tip = None             # ostatnio ustawiona podpowiedź (żeby nie ustawiać jej bez potrzeby)
        self.current = self.selected = False
        self.group = None           # numer grupy kadru indywidualnego (#N) albo None
        self.cell = None            # komórka siatki (Overlay), w której leży miniatura
        self.xbtn = None            # przycisk „usuń z listy”
        self.tight = False          # true: komórka dopasowana do miniatury (panel na dole)
        self.set_cursor_from_name('pointer')
        self.set_draw_func(self.draw)
        self.load()

    def load(self):
        t = GdkPixbuf.Pixbuf.new_from_file_at_size(self.path, CELL, CELL)
        o = t.get_option('orientation')
        _, w, h = GdkPixbuf.Pixbuf.get_file_info(self.path)
        if o in ('5', '6', '7', '8'):
            w, h = h, w
        self.t = t.apply_embedded_orientation() or t
        self.dims = (w, h)
        self.set_content_width(self.t.get_width())
        self.set_content_height(self.t.get_height())
        self.place_x()
        self.queue_draw()

    def place_x(self):
        """Krzyżyk „usuń” przy rogu samego obrazka (w kwadratowej komórce miniatura jest wyśrodkowana)."""
        if self.xbtn:
            dx = 0 if self.tight else max(0, CELL - self.t.get_width()) // 2
            dy = 0
            self.xbtn.set_margin_top(4 + dy)
            self.xbtn.set_margin_end(4 + dx)

    def draw(self, area, cr, W, H):
        W, H = self.t.get_width(), self.t.get_height()
        Gdk.cairo_set_source_pixbuf(cr, self.t, 0, 0)
        cr.paint()
        sel, gid, tag = self.get_info(self)
        shade(cr, 0, 0, W, H, sel, W / self.dims[0], GREEN if gid else ACCENT, tag, 9, (W, H))
        if self.selected:
            cr.set_source_rgba(*ACCENT, .3)
            cr.rectangle(0, 0, W, H)
            cr.fill()
            cr.set_source_rgb(*ACCENT)
            cr.arc(W - 12, H - 12, 9, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(1, 1, 1)
            cr.set_line_width(2)
            cr.move_to(W - 16, H - 12)
            cr.line_to(W - 13, H - 9)
            cr.line_to(W - 8, H - 15)
            cr.stroke()
        if self.current:
            # ramka bieżącego obrazu jest przerywana (jasne kreski na ciemnym podkładzie),
            # żeby różniła się od ciągłej ramki kadru także tam, gdzie kadr dochodzi do krawędzi
            cr.set_line_width(3)
            cr.set_source_rgba(0, 0, 0, .55)
            cr.rectangle(1.5, 1.5, W - 3, H - 3)
            cr.stroke()
            cr.set_source_rgb(1, 1, 1)
            cr.set_dash([6, 4])
            cr.rectangle(1.5, 1.5, W - 3, H - 3)
            cr.stroke()
            cr.set_dash([])


