    # --- start: najpierw okno, potem przywracanie sesji ---
    def on_map(self, *_):
        st, self.st0 = self.st0, None
        if st:
            GLib.idle_add(self.begin, st)

    def begin(self, st):
        self.restore(st)
        return GLib.SOURCE_REMOVE

    def toast(self, text, button=None, action=None, timeout=None):
        t = Adw.Toast.new(text)
        t.set_use_markup(False)
        if button and action:
            t.set_button_label(button)
            t.connect('button-clicked', lambda *_: action())
        if timeout is not None:
            t.set_timeout(timeout)
        self.toasts.add_toast(t)
        if self.sticky_toast:
            # trwały toast nie może blokować kolejki — schodzi na chwilę i wraca za nowym toastem
            self.bumped = True
            self.sticky_toast.dismiss()

    # --- trwałe toasty: „Wyczyszczono listę” (Przywróć) i „błędy” (Szczegóły) ---
    def build_sticky(self, kind):
        if kind == 'clear' and self.cleared:
            t = Adw.Toast.new(f'Wyczyszczono listę obrazów ({len(self.cleared["paths"])})')
            t.set_button_label('Przywróć')
            t.connect('button-clicked', lambda *_: self.restore_cleared())
        elif kind == 'errors' and self.errors:
            t = Adw.Toast.new(self.errors['msg'])
            t.set_button_label('Szczegóły')
            t.connect('button-clicked', lambda *_: self.errors_clicked())
        else:
            return None
        t.set_use_markup(False)
        t.set_timeout(0)    # 0 = nie znika sam
        t.connect('dismissed', self.on_sticky_dismissed)
        return t

    def show_sticky(self, kind):
        """Pokazuje trwały toast; naraz jest tylko jeden (nowy zastępuje poprzedni)."""
        old, self.sticky_toast = self.sticky_toast, None
        self.sticky_kind, self.bumped = kind, False
        if old:
            old.dismiss()
        t = self.build_sticky(kind)
        if t:
            self.sticky_toast = t
            self.toasts.add_toast(t)

    def drop_sticky(self):
        self.sticky_kind = None
        self.bumped = False
        t, self.sticky_toast = self.sticky_toast, None
        if t:
            t.dismiss()

    def on_sticky_dismissed(self, t):
        if self.sticky_toast is not t:
            return
        self.sticky_toast = None
        if self.sticky_kind and self.bumped:
            self.show_sticky(self.sticky_kind)

    def errors_clicked(self):
        self.bumped = True      # przycisk zdejmuje toast, a ten ma zostać do otwarcia nowych obrazów
        self.show_errors()

    def forget_cleared(self):
        """Zapomina zrzut listy i raport błędów (np. po otwarciu nowych obrazów) i zdejmuje trwały toast."""
        self.cleared = None
        self.errors = None
        self.drop_sticky()
        self.persist_soon()

    def restore_cleared(self):
        s, self.cleared = self.cleared, None
        self.bumped = False
        self.sticky_kind = None
        if not s or self.thumbs or self.queue:
            return
        self.hist_reset()
        self.groups = dict(s['groups'])
        self.refs = dict(s['refs'])
        self.add_files(s['paths'], s['current'], s['img_groups'])
        self.dirty = s['dirty'] and self.has_crops()
        self.sync()

    def show_errors(self):
        """Dialog „Szczegóły”: które pliki zawiodły i dlaczego."""
        e = self.errors
        if not e:
            return
        d = Adw.Dialog(follows_content_size=True)
        head_l = Gtk.Label(label=f'{e["title"]} ({len(e["errs"])})', css_classes=['title-2'], wrap=True)
        body_l = Gtk.Label(label=e['intro'], wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=50)
        lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=['boxed-list'], width_request=460)
        for it in e['errs']:
            p = it.get('path') or ''
            row = Adw.ActionRow()
            row.set_title(GLib.markup_escape_text(os.path.basename(p) or 'Błąd ogólny'))
            sub = it['why'] + (f'\n{short(os.path.dirname(p))}' if p else '')
            row.set_subtitle(GLib.markup_escape_text(sub))
            row.set_subtitle_selectable(True)
            lst.append(row)
        sc = Gtk.ScrolledWindow(child=lst, propagate_natural_height=True, max_content_height=340,
                                hscrollbar_policy=Gtk.PolicyType.NEVER, overlay_scrolling=True)
        b_close = Gtk.Button(label='Zamknij', css_classes=['suggested-action'])
        b_close.connect('clicked', lambda b: d.close())
        btns = Gtk.Box(spacing=12, homogeneous=True)
        if e.get('outs'):
            b_show = Gtk.Button(label=self.reveal_label(e['outs'], True))
            b_show.connect('clicked', lambda b: self.reveal_files(e['outs']))
            btns.append(b_show)
        btns.append(b_close)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                      margin_top=24, margin_bottom=20, margin_start=24, margin_end=24)
        for w in (head_l, body_l, sc, btns):
            col.append(w)
        d.set_child(col)
        d.set_default_widget(b_close)
        d.present(self)

    # --- rozmiar okna (zapamiętywany między sesjami) ---
    def on_geom(self, *_):
        self.persist_soon()

    def on_active(self, *_):
        if not self.is_active():
            self.nav_held = 0   # zgubione zdarzenie puszczenia klawisza
            self.nav_queue = 0

    def focus_owner(self):
        """Etykieta „Obraz: …” albo pole liczbowe (X/Y/Szer./Wys.), które ma teraz fokus; inaczej None."""
        w = self.get_focus()
        while w is not None and w is not self:
            if w is self.info or isinstance(w, Gtk.SpinButton):
                return w
            w = w.get_parent()
        return None

    def on_any_press(self, g, n, x, y):
        """Klik poza polem, które ma fokus (etykieta albo pole liczbowe), zdejmuje z niego fokus —
        znika karetka i zaznaczenie. Klik w samo pole (tekst, przyciski +/−) zostaje nietknięty."""
        if self.get_visible_dialog():
            return
        w = self.focus_owner()
        if w is None:
            return
        ok, p = self.compute_point(w, Graphene.Point().init(x, y))
        if ok and w.contains(p.x, p.y):
            return
        self.set_focus(None)

    def on_any_release(self, g, n, x, y):
        """Po kliknięciu w „Obraz: …” bez zaznaczenia żadnej litery karetka nie ma zostać."""
        if self.focus_owner() is self.info:
            GLib.idle_add(self.info_drop_empty)

    def info_drop_empty(self):
        if self.get_focus() is self.info:
            ok, s, e = self.info.get_selection_bounds()
            if not ok or s == e:
                self.set_focus(None)
        return GLib.SOURCE_REMOVE

    # --- panel: dół / prawa strona / ukryty ---
    def cycle_panel(self, _):
        self.set_panel(PANEL_MODES[(PANEL_MODES.index(self.mode) + 1) % len(PANEL_MODES)])

    def set_panel(self, mode):
        self.mode = mode
        par = self.panel.get_parent()
        if par:
            par.remove(self.panel)
        if mode == 'bottom':
            self.bottom_slot.append(self.panel)
        elif mode == 'side':
            self.side_slot.append(self.panel)
        self.bottom_slot.set_visible(mode == 'bottom')
        self.side_slot.set_visible(mode == 'side')
        self.sgrip.set_visible(mode == 'side')
        self.bgrip.set_visible(mode == 'bottom' and bool(self.thumbs))
        side = mode == 'side'
        self.panel.set_margin_top(6 if side else 0)
        self.panel.set_margin_bottom(12 if side else 0)
        self.panel.set_margin_start(6 if side else 0)
        self.panel.set_margin_end(12 if side else 0)
        self.layout_panel()
        self.apply_sizes()
        self.reflow(True)
        self.upd_count()
        self.panel_icon.set_state(mode)
        self.b_panel.set_tooltip_text(PANEL_TIP[mode])
        self.persist_soon()

    def layout_panel(self):
        side = self.mode == 'side'
        for w in self.fw + [self.tools]:
            p = w.get_parent()
            if p is self.grid:
                self.grid.remove(w)
            elif p is self.tools:
                self.tools.remove(w)
        for w, (c, r, sp) in zip(self.fw, GRID_SIDE if side else GRID_BOTTOM):
            self.grid.attach(w, c, r, sp, 1)
        if side:
            self.grid.attach(self.tools, 0, 3, 4, 1)
            self.tools_reflow()
        self.grid.set_column_homogeneous(False)
        self.grid.set_row_spacing(6 if side else 8)
        self.info_box.set_margin_top(6 if side else 0)
        self.info_box.set_hexpand(not side)
        for w in (self.fw[2], self.fw[6]):      # etykiety Y i Wys.: odstęp od poprzedniego pola w tej samej linii
            w.set_margin_start(8 if side else 0)
        self.tools.set_margin_top(4 if side else 0)
        for sp in self.spins.values():
            sp.set_hexpand(side)
            sp.set_margin_end(0 if side else 4)
            sp.set_width_chars(1 if side else 5)    # w sidebarze pola się rozciągają, więc nie rozpychają panelu
            if side:
                sp.add_css_class('slim-spin')
            else:
                sp.remove_css_class('slim-spin')
        self.info.set_halign(Gtk.Align.FILL)
        self.btns_reflow()
        va = Gtk.Align.START if side else Gtk.Align.CENTER
        for w in (self.info_box, self.info, self.count_box, self.count, self.btns, self.b_desel, self.b_clear):
            w.set_valign(va)
        self.info.set_xalign(0 if side else 1)
        # na dole etykiety skracają się wielokropkiem — ich długość nie może wymuszać szerokości okna
        self.info.set_wrap(side)
        self.info.set_ellipsize(Pango.EllipsizeMode.NONE if side else Pango.EllipsizeMode.END)
        self.info.set_max_width_chars(self.info_chars() if side else -1)
        self.count.set_wrap(side)
        self.count.set_ellipsize(Pango.EllipsizeMode.NONE if side else Pango.EllipsizeMode.END)
        self.count.set_max_width_chars(self.count_chars() if side else -1)
        # sizerki powtarzają ustawienia etykiet; tekst przy górze komórki, żeby nic nie "pływało"
        self.info.set_yalign(0 if side else 0.5)
        self.count.set_yalign(0 if side else 0.5)
        self.cfg_sz(self.count_sz, self.count)
        for sz in self.info_szs.values():
            self.cfg_sz(sz, self.info)
        self.upd_desel()
        self.zrow.set_halign(Gtk.Align.START if side else Gtk.Align.END)
        self.zrow.set_hexpand(False)
        self.nrow.set_halign(Gtk.Align.START if side else Gtk.Align.END)
        self.nrow.set_hexpand(False)
        self.tgrid.set_halign(Gtk.Align.CENTER if side else Gtk.Align.START)
        self.tgrid.set_valign(Gtk.Align.START if side else Gtk.Align.CENTER)
        # stały zapas na nakładkowy suwak: pod miniaturami (dół) albo z prawej strony (sidebar)
        self.tgrid.set_margin_bottom(0 if side else SB)
        self.tgrid.set_margin_end(SB if side else 0)
        if side:
            self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        else:
            self.scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        self.scroll.set_propagate_natural_height(False)
        self.scroll.set_vexpand(side)
        self.extra.set_vexpand(side)
        self.panel.set_vexpand(side)

    def apply_sizes(self):
        self.side_slot.set_size_request(self.side_w, -1)
        if self.mode == 'side':
            self.scroll.set_min_content_height(CELL)
        else:
            self.scroll.set_min_content_height(self.rows * (CELL + GAP) - GAP + SB)

    def max_rows(self):
        return max(1, (self.get_height() - ROWS_OVERHEAD + GAP) // (CELL + GAP))

    def set_rows(self, r):
        self.rows = r
        self.apply_sizes()
        self.reflow()
        self.persist_soon()

    def count_chars(self):
        return max(8, (self.side_w - (130 if self.btn_stack else 180)) // 8)

    def info_chars(self):
        return max(12, (self.side_w - 30) // 8)

    def chars(self):
        """Zawijanie etykiet w sidebarze zależy od jego szerokości (sizerki mają to samo, co etykiety)."""
        side = self.mode == 'side'
        n = self.info_chars()
        for w in [self.info] + list(self.info_szs.values()):
            w.set_max_width_chars(n if side else -1)
        n = self.count_chars()
        for w in (self.count, self.count_sz):
            w.set_max_width_chars(n if side else -1)

    def cfg_sz(self, sz, lab):
        """Sizerka powtarza ustawienia swojej etykiety; tekst przy górze komórki, żeby nic nie „pływało”."""
        side = self.mode == 'side'
        sz.set_yalign(0 if side else 0.5)
        sz.set_halign(lab.get_halign())
        sz.set_xalign(lab.get_xalign())
        sz.set_wrap(side)
        sz.set_ellipsize(lab.get_ellipsize())
        sz.set_max_width_chars(lab.get_max_width_chars())
        sz.set_visible(side)

    def sync_info_sz(self, texts):
        """Dopasowuje zestaw sizerek do aktualnych opisów obrazów (zmienia je tylko, gdy zestaw się zmienił)."""
        have, want = set(self.info_szs), set(texts)
        if have == want:
            return
        for t in have - want:
            self.info_box.remove(self.info_szs.pop(t))
        for t in want - have:
            sz = dim(t)
            sz.set_hexpand(True)
            sz.set_opacity(0)
            sz.set_can_target(False)
            self.cfg_sz(sz, self.info)
            self.info_box.attach(sz, 0, 0, 1, 1)
            self.info_szs[t] = sz

    def btns_reflow(self):
        """„Odznacz” i „Wyczyść”: obok siebie, a gdy w panelu bocznym zostaje za mało miejsca na tekst
        obok nich (COUNT_MIN) — „Wyczyść” wskakuje pod „Odznacz”."""
        def wd(b):
            return b.measure(Gtk.Orientation.HORIZONTAL, -1)[1] or 80
        need = wd(self.b_desel) + wd(self.b_clear) + 6
        stack = self.mode == 'side' and self.side_w - SIDE_PAD - need < COUNT_MIN
        if stack == self.btn_stack and self.b_clear.get_parent() is self.btns:
            return
        self.btn_stack = stack
        for b in (self.b_desel, self.b_clear):
            if b.get_parent() is self.btns:
                self.btns.remove(b)
        self.btns.attach(self.b_desel, 0, 0, 1, 1)
        self.btns.attach(self.b_clear, 0 if stack else 1, 1 if stack else 0, 1, 1)

    def tools_reflow(self):
        """Zoom i nawigacja w sidebarze: nawigacja stoi obok zoomu, dopóki mieści się w szerokości panelu."""
        for w in (self.zrow, self.nrow):
            if w.get_parent() is self.tools:
                self.tools.remove(w)
        zw = self.zrow.measure(Gtk.Orientation.HORIZONTAL, -1)[1]
        nw = self.nrow.measure(Gtk.Orientation.HORIZONTAL, -1)[1]
        self.tools.attach(self.zrow, 0, 0, 1, 1)
        if zw + nw + 6 <= self.side_w - SIDE_PAD:
            self.tools.attach(self.nrow, 1, 0, 1, 1)
        else:
            self.tools.attach(self.nrow, 0, 1, 1, 1)

    def set_side_w(self, w):
        self.side_w = w
        self.apply_sizes()
        if self.mode == 'side':
            self.btns_reflow()
            self.chars()
            self.tools_reflow()
        self.reflow()
        self.persist_soon()

    def rows_move(self, r0, dx, dy):
        r = max(1, min(self.max_rows(), round(r0 - dy / (CELL + GAP))))
        if r != self.rows:
            self.set_rows(r)

    def side_max(self):
        """Największa szerokość panelu, przy której pole kadrowania nie spada poniżej minimum.
        Powyżej tego progu panel się już nie poszerza (zamiast rozpychać okno)."""
        return max(SIDE_MIN, self.get_width() - CANVAS_MIN - LEFT_PAD - GRIP_W)

    def side_move(self, w0, dx, dy):
        w = min(max(round(w0 - dx), SIDE_MIN), self.side_max())
        if w != self.side_w:
            self.set_side_w(w)

    def style_cell(self, t, side):
        """Panel po prawej: równe kwadraty. Panel na dole: komórka dopasowana do miniatury (małe odstępy)."""
        t.tight = not side
        t.cell.set_halign(Gtk.Align.CENTER)
        t.cell.set_valign(Gtk.Align.CENTER)
        t.cell.set_size_request(CELL if side else -1, -1)
        t.place_x()

    def per_line(self):
        if self.mode == 'side':
            return max(1, (self.side_w - SIDE_PAD - SB + GAP) // (CELL + GAP))
        return max(1, self.rows)

    def reflow(self, force=False):
        """Układa komórki miniatur w siatce: w sidebarze wierszami, na dole kolumnami."""
        side = self.mode == 'side'
        per = self.per_line()
        key = (side, per, len(self.thumbs))
        if key == self.lkey and not force:
            return
        self.lkey = key
        for t in self.thumbs:
            if t.cell.get_parent() is self.tgrid:
                self.tgrid.remove(t.cell)
            self.style_cell(t, side)
        for i, t in enumerate(self.thumbs):
            c, r = (i % per, i // per) if side else (i // per, i % per)
            self.tgrid.attach(t.cell, c, r, 1, 1)

    def place_last(self):
        """Dokłada do siatki tylko ostatnio dodaną miniaturę (bez przekładania wszystkich)."""
        side = self.mode == 'side'
        per = self.per_line()
        n = len(self.thumbs)
        if self.lkey != (side, per, n - 1):
            self.reflow(True)
            return
        t = self.thumbs[-1]
        self.style_cell(t, side)
        i = n - 1
        c, r = (i % per, i // per) if side else (i // per, i % per)
        self.tgrid.attach(t.cell, c, r, 1, 1)
        self.lkey = (side, per, n)

    # --- zapamiętywanie sesji ---
    def persist(self):
        if not self.ready:
            return
        if self.ptimer:
            GLib.source_remove(self.ptimer)
            self.ptimer = 0
        w, h = self.get_default_size()
        img_groups = {t.path: t.group for t in self.thumbs if t.group}
        img_groups.update(self.load_groups)
        cl = self.cleared
        cleared = None
        if cl:
            cleared = {'paths': cl['paths'], 'current': cl['current'],
                       'groups': {str(g): c for g, c in cl['groups'].items()},
                       'refs': {str(k): list(v) for k, v in cl['refs'].items()},
                       'img_groups': cl['img_groups'], 'dirty': cl['dirty']}
        view = self.view0
        if view is None and self.cur:
            vs = self.area.view_state()
            if vs and vs[0] > 1.0:
                view = {'path': self.cur.path, 'zoom': vs[0], 'cx': vs[1], 'cy': vs[2]}
        save_state({'crop': self.general, 'dirty': self.dirty, 'view': view,
                    'groups': {str(g): c for g, c in self.groups.items()},
                    'refs': {str(k): list(v) for k, v in self.refs.items()},
                    'img_groups': img_groups,
                    'images': [t.path for t in self.thumbs] + list(self.queue),
                    'current': self.cur.path if self.cur else self.load_first,
                    'scheme': self.scheme, 'panel': self.mode,
                    'rows': self.rows, 'side_w': self.side_w,
                    'win_w': w if w >= 400 else WIN_W, 'win_h': h if h >= 300 else WIN_H,
                    'maximized': self.is_maximized(),
                    'cleared': cleared})

    def persist_soon(self):
        if not self.ready:
            return
        if self.ptimer:
            GLib.source_remove(self.ptimer)

        def tick():
            self.ptimer = 0
            self.persist()
            return GLib.SOURCE_REMOVE
        self.ptimer = GLib.timeout_add(400, tick)

    def restore(self, st):
        """Przywraca sesję już po pokazaniu okna: obrazy ładują się po jednym, w tle."""
        self.restoring = False
        paths = [p for p in st['images'] if os.path.isfile(p)]
        missing = len(st['images']) - len(paths)
        if self.view0 and self.view0['path'] not in paths:
            self.view0 = None
        if paths:
            self.add_files(paths, st['current'], st['img_groups'], front=True)
        self.dirty = st['dirty'] and self.has_crops()
        self.ready = True
        if missing:
            self.toast(f'Nie znaleziono plików z poprzedniej sesji: {missing}')
        # lista wyczyszczona w poprzedniej sesji: przycisk „Przywróć” wraca, o ile nic nowego nie otwarto
        if not st['images'] and st['cleared'] and not self.thumbs and not self.queue:
            self.cleared = st['cleared']
            self.show_sticky('clear')
        if not self.loading:
            self.gc()
        self.sync()

    # --- kadry: ogólny i indywidualne (#N), skalowanie pod obrazy o tych samych proporcjach ---
    def raw_of(self, t):
        """Kadr tak, jak został zapisany (w pikselach obrazu wzorcowego)."""
        return self.groups.get(t.group) if t.group else self.general

    def ratio(self, t):
        """(kx, ky): o ile kadr obrazu t jest przeskalowany względem obrazu wzorcowego.
        None, gdy skalowanie nie dotyczy (brak wzorca, ten sam rozmiar albo inne proporcje)."""
        ref = self.refs.get(t.group or 0)
        if not ref:
            return None
        (rw, rh), (iw, ih) = ref, t.dims
        if (rw, rh) == (iw, ih):
            return None
        if abs(rw * ih - rh * iw) > SCALE_TOL * max(rw * ih, rh * iw):
            return None
        return iw / rw, ih / rh

    def crop_of(self, t):
        """Kadr dla obrazu t — przeliczony na jego rozmiar, jeśli ma te same proporcje co wzorzec."""
        c = self.raw_of(t)
        r = self.ratio(t) if c else None
        if not r:
            return c
        kx, ky = r
        x0, y0 = round(c[0] * kx), round(c[1] * ky)
        x1, y1 = round((c[0] + c[2]) * kx), round((c[1] + c[3]) * ky)
        return [x0, y0, max(1, x1 - x0), max(1, y1 - y0)]

    def tag_of(self, t):
        """Plakietka na kadrze: #N (kadr indywidualny) i/lub % (kadr przeskalowany pod ten obraz)."""
        scaled = bool(self.raw_of(t)) and self.ratio(t) is not None
        parts = ([f'#{t.group}'] if t.group else []) + ([SCALE_TAG] if scaled else [])
        return ' '.join(parts) or None

    def store(self, sel):
        """Zapisuje kadr zaznaczony na bieżącym obrazie — ten obraz zostaje jego wzorcem."""
        t = self.cur
        key = t.group if t and t.group else 0
        if t and t.group:
            self.groups[t.group] = sel
        else:
            self.general = sel
        if sel and t:
            self.refs[key] = tuple(t.dims)
        else:
            self.refs.pop(key, None)

    def info_for(self, t):
        return self.crop_of(t), t.group, self.tag_of(t)

    def has_crops(self):
        return bool(self.general or any(self.groups.values()))

    def gc(self):
        used = {t.group for t in self.thumbs if t.group} | set(self.load_groups.values())
        self.groups = {g: c for g, c in self.groups.items() if g in used}
        self.refs = {k: v for k, v in self.refs.items() if k == 0 or k in self.groups}
        for d in (self.hist, self.redo_st):
            for k in [k for k in d if k and k not in self.groups]:
                del d[k]

    def free_gid(self):
        g = 2
        while g in self.groups:
            g += 1
        return g

    def targets(self):
        """Obrazy, których dotyczy przycisk trybu indywidualnego: całe zaznaczenie (≥2) tylko wtedy,
        gdy bieżący obraz do niego należy; w innym wypadku wyłącznie bieżący obraz (zaznaczenie zostaje)."""
        if len(self.selected) >= 2 and self.cur in self.selected:
            return [t for t in self.thumbs if t in self.selected]
        return [self.cur] if self.cur else []

    def toggle_indiv(self, _):
        ts = self.targets()
        if not ts:
            return
        if all(t.group for t in ts):
            for t in ts:
                t.group = None
            self.gc()
        else:
            base = self.cur if self.cur in ts else ts[0]
            crop = self.crop_of(base)
            for t in ts:
                t.group = None
            self.gc()
            gid = self.free_gid()
            self.groups[gid] = list(crop) if crop else None
            if crop:
                self.refs[gid] = tuple(base.dims)
            else:
                self.refs.pop(gid, None)
            for t in ts:
                t.group = gid
        self.dirty = True
        self.sync()

    def on_crop(self, *_):
        if not self.dragging:
            self.dragging = True
            self.hist_push()        # jeden krok cofania na całe przeciągnięcie
        self.store(self.area.sel)
        self.dirty = True
        self.sync()

    def on_edit_end(self, *_):
        self.dragging = False
        self.hist_tag = None

    # --- cofanie kadru: osobna historia dla kadru ogólnego (0) i dla każdego kadru indywidualnego (#N) ---
    def ckey(self):
        """Klucz kadru, który właśnie edytujesz: numer grupy (#N) bieżącego obrazu albo 0 (kadr ogólny)."""
        return self.cur.group if self.cur and self.cur.group else 0

    def hist_snap(self, key):
        c = self.general if key == 0 else self.groups.get(key)
        return {'crop': list(c) if c else None, 'ref': self.refs.get(key)}

    def hist_apply(self, key, snap):
        c = list(snap['crop']) if snap['crop'] else None
        if key == 0:
            self.general = c
        elif key in self.groups:
            self.groups[key] = c
        if snap['ref']:
            self.refs[key] = snap['ref']
        else:
            self.refs.pop(key, None)

    def hist_push(self, tag=None):
        """Zapamiętuje stan edytowanego kadru sprzed zmiany. Kolejne zmiany z tym samym tagiem (np. seria
        kliknięć w polu liczbowym) w krótkim odstępie czasu liczą się jako jeden krok."""
        key = self.ckey()
        now = GLib.get_monotonic_time() // 1000
        mark = (key, tag) if tag else None
        if mark and mark == self.hist_tag and now - self.hist_t < 900:
            self.hist_t = now
            return
        self.hist_tag, self.hist_t = mark, now
        snap = self.hist_snap(key)
        h = self.hist.setdefault(key, [])
        if h and h[-1] == snap:
            return
        h.append(snap)
        del h[:-HIST_MAX]
        self.redo_st[key] = []

    def hist_reset(self):
        self.hist, self.redo_st = {}, {}
        self.hist_tag = None

    def hist_undo(self, *_):
        key = self.ckey()
        h = self.hist.get(key)
        if not h or self.saving:
            return
        self.redo_st.setdefault(key, []).append(self.hist_snap(key))
        self.hist_apply(key, h.pop())
        self.hist_after()

    def hist_redo(self):
        key = self.ckey()
        r = self.redo_st.get(key)
        if not r or self.saving:
            return
        self.hist.setdefault(key, []).append(self.hist_snap(key))
        self.hist_apply(key, r.pop())
        self.hist_after()

    def hist_after(self):
        self.hist_tag = None
        self.dirty = True
        self.area.loupe_off()
        self.sync()

    # --- proporcje kadru ---
    def crop_set(self, new):
        """Ustawia kadr na bieżącym obrazie jako jeden krok cofania."""
        a = self.area
        if not a.pix or a.sel == new:
            return
        self.hist_push()
        a.sel = new
        self.store(new)
        self.dirty = True
        self.sync()

    def fit_box(self, cx, cy, w, h):
        """Kadr o środku (cx, cy) i proporcjach w:h, jak największy do rozmiaru w×h, ale mieszczący się w obrazie."""
        iw, ih = self.area.size
        r = w / h
        k = min(1.0, iw / w, ih / h)
        W = max(1, min(iw, round(w * k)))
        H = max(1, min(ih, round(W / r)))
        X = min(max(round(cx - W / 2), 0), iw - W)
        Y = min(max(round(cy - H / 2), 0), ih - H)
        self.crop_set([X, Y, W, H])

    def ratio_apply(self, key):
        """Ustawia proporcję kadru: środek i pole zostają, a gdy kadru nie ma — największy możliwy na środku."""
        a = self.area
        if not a.pix:
            return
        iw, ih = a.size
        if key == 'img':
            r = iw / ih
        else:
            p, q = key.split(':')
            r = int(p) / int(q)
        s = a.sel
        if s and s[2] > 0 and s[3] > 0:
            area, cx, cy = s[2] * s[3], s[0] + s[2] / 2, s[1] + s[3] / 2
        else:
            area, cx, cy = iw * ih, iw / 2, ih / 2
        w = math.sqrt(area * r)
        self.fit_box(cx, cy, w, w / r)

    def ratio_flip(self):
        s = self.area.sel
        if s and s[2] > 0 and s[3] > 0:
            self.fit_box(s[0] + s[2] / 2, s[1] + s[3] / 2, s[3], s[2])

    def ratio_center(self):
        a = self.area
        s = a.sel
        if not (a.pix and s):
            return
        iw, ih = a.size
        self.crop_set([max(0, round((iw - s[2]) / 2)), max(0, round((ih - s[3]) / 2)), s[2], s[3]])

    def upd_tools(self):
        has = self.cur is not None and self.area.pix is not None and not self.saving
        key = self.ckey()
        self.b_hundo.set_sensitive(bool(self.hist.get(key)) and not self.saving)
        self.b_hundo.set_tooltip_text(
            ('Cofnij zmianę kadru ogólnego' if key == 0 else f'Cofnij zmianę kadru indywidualnego #{key}')
            + ' (Ctrl+Z)\nCtrl+Shift+Z — ponów\nKażdy kadr (ogólny i każdy #N) ma własną historię.\n'
              'Działa też na kadr zmieniany myszą i polami liczbowymi.')
        self.b_ratio.set_sensitive(has)
        self.act_flip.set_enabled(has and bool(self.area.sel))
        self.act_center.set_enabled(has and bool(self.area.sel))

    def upd_desel(self):
        """„Odznacz”: w sidebarze zostaje w układzie (tylko niewidoczny), żeby jego pojawienie się
        nie zwężało tekstu obok i nie zmieniało liczby linii."""
        on = bool(self.selected)
        self.b_desel.set_visible(on or self.mode == 'side')
        self.b_desel.set_opacity(1 if on else 0)
        self.b_desel.set_can_target(on)
        self.b_desel.set_focusable(on)

    # --- pytanie o zamknięcie w dymku przy przycisku ✕ ---
    def close_button_under_pointer(self):
        """Przycisk zamknięcia okna, jeśli wskaźnik jest nad nim (czyli to w niego kliknięto)."""
        w = self.tv.pick(self.mp[0], self.mp[1], Gtk.PickFlags.DEFAULT)
        while w is not None and w is not self.tv:
            if isinstance(w, Gtk.Button) and w.has_css_class('close') and w.get_mapped():
                return w
            w = w.get_parent()
        return None

    def ask_close_pop(self, btn):
        pop = Gtk.Popover(autohide=True, has_arrow=True, position=Gtk.PositionType.BOTTOM)
        pop.set_parent(btn)
        head_l = Gtk.Label(label='Zamknąć bez zapisania kadru?', css_classes=['heading'], xalign=0, wrap=True,
                           max_width_chars=32)
        body_l = dim('Kadr nie został zapisany w żadnym obrazie. Przy następnym uruchomieniu wróci '
                     'razem z listą obrazów, a pliki na dysku zostaną bez zmian.')
        body_l.set_wrap(True)
        body_l.set_xalign(0)
        body_l.set_max_width_chars(32)
        b_back = Gtk.Button(label='Wróć')
        b_close = Gtk.Button(label='Zamknij', css_classes=['destructive-action'])
        btns = Gtk.Box(spacing=8, homogeneous=True, margin_top=4)
        btns.append(b_back)
        btns.append(b_close)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        for w in (head_l, body_l, btns):
            col.append(w)
        pop.set_child(col)
        pop.set_default_widget(b_back)
        b_back.connect('clicked', lambda b: pop.popdown())
        b_close.connect('clicked', lambda b: self.pop_close(pop))
        pop.connect('closed', self.on_pop_closed)
        self.close_pop = pop
        pop.popup()
        b_back.grab_focus()
        return True

    def pop_close(self, pop):
        self.force_close = True
        pop.popdown()
        GLib.idle_add(self.close_now)

    def close_now(self):
        self.close()
        return GLib.SOURCE_REMOVE

    def on_pop_closed(self, pop):
        if self.close_pop is pop:
            self.close_pop = None
        pop.unparent()

    # --- zamykanie okna ---
    def is_dirty(self):
        return bool(self.dirty and self.has_crops() and self.thumbs)

    def on_close(self, *_):
        if self.saving:
            self.toast('Trwa zapisywanie — zamknij okno, gdy się skończy')
            return True
        if self.force_close or not self.is_dirty():
            self.persist()
            return False
        if self.close_dlg or self.close_pop:
            return True
        btn = self.close_button_under_pointer()
        if btn is not None:
            return self.ask_close_pop(btn)      # kliknięto ✕ — pytanie w dymku przy nim
        d = Adw.AlertDialog(heading='Zamknąć bez zapisania kadru?',
                            body='Kadr nie został zapisany w żadnym obrazie. Przy następnym uruchomieniu '
                                 'wróci razem z listą obrazów, a pliki na dysku zostaną bez zmian.')
        d.add_response('cancel', 'Wróć')
        d.add_response('close', 'Zamknij')
        d.set_response_appearance('close', Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_default_response('cancel')
        d.set_close_response('cancel')
        d.connect('response', self.on_close_resp)
        self.close_dlg = d
        d.present(self)
        return True

    def on_close_resp(self, d, r):
        self.close_dlg = None
        if r == 'close':
            self.force_close = True
            self.close()

    # --- klawiatura i kółko ---
    def on_key(self, ctrl, keyval, keycode, state):
        if self.close_pop or self.get_visible_dialog() or isinstance(self.get_focus(), Gtk.Editable):
            return False
        if self.saving:
            return True         # w trakcie zapisu skróty klawiszowe są wyłączone
        ctrl_m, alt_m = Gdk.ModifierType.CONTROL_MASK, Gdk.ModifierType.ALT_MASK
        if state & ctrl_m and not state & alt_m:
            if keyval in (Gdk.KEY_v, Gdk.KEY_V):
                self.paste()
                return True
            if keyval in (Gdk.KEY_a, Gdk.KEY_A):
                self.set_selected(set(self.thumbs))
                return True
            if keyval in (Gdk.KEY_z, Gdk.KEY_Z):
                if state & Gdk.ModifierType.SHIFT_MASK:
                    self.hist_redo()
                else:
                    self.hist_undo()
                return True
            if keyval in (Gdk.KEY_y, Gdk.KEY_Y):
                self.hist_redo()
                return True
        if state & (ctrl_m | alt_m):
            return False
        if keyval == Gdk.KEY_Escape:
            if self.get_focus() is self.info:
                self.set_focus(None)
            elif not self.selected:
                return False
            else:
                self.set_selected(set())
        elif keyval in (Gdk.KEY_Left, Gdk.KEY_KP_Left):
            self.nav_press(-1)
        elif keyval in (Gdk.KEY_Right, Gdk.KEY_KP_Right):
            self.nav_press(1)
        elif keyval in (Gdk.KEY_Up, Gdk.KEY_KP_Up, Gdk.KEY_plus, Gdk.KEY_KP_Add, Gdk.KEY_equal):
            self.area.zoom_by(ZOOM_STEP, True)
        elif keyval in (Gdk.KEY_Down, Gdk.KEY_KP_Down, Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
            self.area.zoom_by(1 / ZOOM_STEP, True)
        else:
            return False
        return True

    def on_key_up(self, ctrl, keyval, keycode, state):
        d = (-1 if keyval in (Gdk.KEY_Left, Gdk.KEY_KP_Left) else
             1 if keyval in (Gdk.KEY_Right, Gdk.KEY_KP_Right) else 0)
        if d and self.nav_held == d:
            self.nav_held = 0

    # Przewijanie obrazów: strzałka (także przytrzymana) i kółko myszy idą przez jeden mechanizm
    # zsynchronizowany z klatkami — każdy obraz zdąży się narysować, zanim wejdzie następny.
    def nav_press(self, d):
        if self.nav_held == d:
            return              # systemowe powtarzanie klawisza — rytm nadaje nav_tick
        self.nav_held = d
        self.nav_queue = 0
        self.step(d)
        self.nav_next = GLib.get_monotonic_time() // 1000 + NAV_FIRST
        self.nav_run()

    def nav_push(self, k):
        if self.nav_queue * k < 0:
            self.nav_queue = 0
        self.nav_queue = max(-NAV_QUEUE, min(NAV_QUEUE, self.nav_queue + k))
        self.nav_run()

    def nav_run(self):
        if not self.nav_id:
            self.nav_id = self.add_tick_callback(self.nav_tick)

    def nav_tick(self, widget, clock):
        if self.get_visible_dialog():
            self.nav_held, self.nav_queue = 0, 0
        now = GLib.get_monotonic_time() // 1000
        if now >= self.nav_next:
            d = 0
            if self.nav_queue:
                d = 1 if self.nav_queue > 0 else -1
                self.nav_queue -= d
            elif self.nav_held:
                d = self.nav_held
            if d:
                self.nav_next = now + NAV_STEP
                self.step(d)
        if self.nav_held or self.nav_queue or now < self.nav_next:
            return GLib.SOURCE_CONTINUE
        self.nav_id = 0
        return GLib.SOURCE_REMOVE

    def on_wheel(self, dx, dy):
        """Kółko nad panelem, paskiem przycisków, nagłówkiem i panelem bocznym przełącza obrazy.
        Nad obrazem (zoom), polami liczbowymi i suwakami zostaje zachowanie domyślne."""
        if not self.thumbs or self.get_visible_dialog():
            return False
        n = self.tv.pick(self.mp[0], self.mp[1], Gtk.PickFlags.DEFAULT)
        while n is not None and n is not self.tv:
            if n is self.area or isinstance(n, (Gtk.Scrollbar, Gtk.SpinButton)):
                return False
            n = n.get_parent()
        d = dy or dx
        if self.sacc * d < 0:
            self.sacc = 0.0
        self.sacc += d
        k = int(self.sacc)
        if k:
            self.sacc -= k
            self.nav_push(k)
        return True

    def step(self, d):
        if not self.cur or not self.thumbs:
            return
        i = min(max(self.thumbs.index(self.cur) + d, 0), len(self.thumbs) - 1)
        if self.thumbs[i] is not self.cur:
            self.show(self.thumbs[i])

    def reveal(self, t):
        """Przewija listę miniatur (tylko w jej osi) tak, żeby aktywna była widoczna."""
        try:
            if t.cell and t.cell.get_parent() is self.tgrid:
                ok, r = t.cell.compute_bounds(self.tgrid)
                if ok:
                    if self.mode == 'side':
                        adj, pos, size = self.scroll.get_vadjustment(), r.get_y(), r.get_height()
                    else:
                        adj, pos, size = self.scroll.get_hadjustment(), r.get_x(), r.get_width()
                    if pos < adj.get_value():
                        adj.set_value(pos - 8)
                    elif pos + size > adj.get_value() + adj.get_page_size():
                        adj.set_value(pos + size - adj.get_page_size() + 8)
        except Exception:
            pass
        return False

    def upd_zoom(self, *_):
        a = self.area
        has = a.pix is not None
        self.z_fit.set_label(f'{round(a.scale() * 100)}%' if has else '—')
        for b in (self.z_in, self.z_out, self.z_fit):
            b.set_sensitive(has)
        self.persist_soon()

