def short(path):
    home = os.path.expanduser('~')
    return '~' + path[len(home):] if path == home or path.startswith(home + os.sep) else path


def unique(path):
    if not os.path.exists(path):
        return path
    root, ext = os.path.splitext(path)
    i = 1
    while os.path.exists(f'{root}-{i}{ext}'):
        i += 1
    return f'{root}-{i}{ext}'


def err_text(e):
    """Czytelna przyczyna błędu (do raportu „Szczegóły”)."""
    if isinstance(e, GLib.Error):
        return e.message
    if isinstance(e, OSError):
        return e.strerror or str(e)
    return str(e)


def okna(n):
    """Odmiana: 1 okno, 2–4 okna, 5+ okien."""
    return 'okno' if n == 1 else 'okna' if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14 else 'okien'


@functools.lru_cache(maxsize=None)
def fm_selects_all():
    """Czy domyślny menedżer plików pokaże kilka plików z jednego folderu w jednym oknie, z zaznaczeniem
    wszystkich. Starszy Nemo przechodził po plikach w pętli i otwierał osobne okno na każdy z nich,
    więc dla niego (i dla nieznanych menedżerów) wybieramy bezpieczną opcję: jedno okno, jeden plik."""
    try:
        app = Gio.AppInfo.get_default_for_type('inode/directory', False)
        fid = (app.get_id() or '').lower() if app else ''
    except Exception:
        return False
    if fid.startswith('nemo'):
        try:
            out = subprocess.run(['nemo', '--version'], capture_output=True, text=True, timeout=3).stdout
            m = re.search(r'(\d+)\.(\d+)', out)
            return bool(m) and (int(m.group(1)), int(m.group(2))) >= NEMO_ALL
        except (OSError, subprocess.SubprocessError):
            return False
    return False


def save_dir(path):
    """Folder domyślnego zapisu: obok oryginału; bitmapy wklejone ze schowka idą do folderu Obrazy."""
    d = os.path.dirname(path)
    if d == PASTE_DIR:
        return GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or os.path.expanduser('~')
    return d


def apply_scheme(scheme, name, now, nr):
    """Schemat nazwy (bez rozszerzenia): kody strftime, [nazwa] i [nr]."""
    try:
        s = now.strftime(scheme)
    except ValueError:
        s = scheme
    s = s.replace('[nr]', str(nr)).replace('[nazwa]', name)
    s = s.replace(os.sep, '_').replace('\0', '').strip()
    return s or name


def out_name(path, scheme, now, nr):
    """Nazwa pliku wynikowego wg schematu; formaty bez zapisu idą do PNG."""
    root, ext = os.path.splitext(os.path.basename(path))
    fmt = WRITABLE.get(ext.lower().lstrip('.'))
    if not fmt:
        fmt, ext = 'png', '.png'
    return apply_scheme(scheme, root, now, nr) + ext, fmt


def shade(cr, ox, oy, w, h, sel, s, color=ACCENT, label=None, fs=12, bounds=None, overflow=False,
          dark=True):
    """Przyciemnia obszar poza kadrem, rysuje ramkę w danym kolorze i opcjonalną plakietkę (#N, %)."""
    if not sel:
        return
    # fx/fy — pełny kadr (może wystawać poza obraz), x/y — jego część na obrazie
    fx0, fy0 = sel[0] * s, sel[1] * s
    fx1, fy1 = (sel[0] + sel[2]) * s, (sel[1] + sel[3]) * s
    x0, y0 = min(max(fx0, 0), w), min(max(fy0, 0), h)
    x1, y1 = min(max(fx1, 0), w), min(max(fy1, 0), h)
    inside = x1 > x0 and y1 > y0
    cr.set_fill_rule(cairo.FillRule.EVEN_ODD)
    if dark:        # w trakcie przeciągania kadru nic nie jest przyciemniane — widać, co się kadruje
        cr.rectangle(ox, oy, w, h)
        if inside:
            cr.rectangle(ox + x0, oy + y0, x1 - x0, y1 - y0)
        cr.set_source_rgba(0, 0, 0, .6)
        cr.fill()
    if overflow and fx1 > fx0 and fy1 > fy0:
        # overflow (podgląd): ramka obejmuje cały kadr, a część poza obrazem dostaje lekki odcień
        cr.rectangle(ox + fx0, oy + fy0, fx1 - fx0, fy1 - fy0)
        if inside:
            cr.rectangle(ox + x0, oy + y0, x1 - x0, y1 - y0)
        cr.set_source_rgba(*color, .18)
        cr.fill()
        x0, y0, x1, y1 = fx0, fy0, fx1, fy1
    elif not inside:
        return
    cr.set_source_rgb(*color)
    cr.set_line_width(2)
    cr.rectangle(ox + x0, oy + y0, x1 - x0, y1 - y0)
    cr.stroke()
    if label:
        cr.select_font_face('sans', cairo.FontSlant.NORMAL, cairo.FontWeight.BOLD)
        cr.set_font_size(fs)
        parts = label.split()
        exts = [cr.text_extents(p) for p in parts]
        ws = [e.width + 8 for e in exts]
        pw, ph = sum(ws), fs + 4
        px, py = ox + x0 + 1, oy + y0 + 1    # 1 px = połowa grubości ramki: plakietka leży w środku, nie na kresce
        if bounds:
            px = min(max(px, 0), bounds[0] - pw)
            py = min(max(py, 0), bounds[1] - ph)
        # każdy człon ma własne tło: % żółte, #N w kolorze ramki (zielony przy kadrze indywidualnym)
        for part, te, w in zip(parts, exts, ws):
            cr.set_source_rgb(*(YELLOW if SCALE_TAG in part else color))
            cr.rectangle(px, py, w, ph)
            cr.fill()
            cr.set_source_rgb(.08, .08, .08)
            cr.move_to(px + 4 - te.x_bearing, py + ph / 2 - te.y_bearing - te.height / 2)
            cr.show_text(part)
            px += w


def center_text(cr, text, W, y):
    te = cr.text_extents(text)
    cr.move_to((W - te.width) / 2, y)
    cr.show_text(text)


class Icon(Gtk.DrawingArea):
    """Mała ikona rysowana w cairo — kolor z motywu, stan wpływa na wygląd."""

    def __init__(self, fn):
        super().__init__(content_width=16, content_height=16, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.fn, self.state = fn, None
        self.set_draw_func(self.paint)

    def paint(self, area, cr, W, H):
        try:
            c = self.get_color()
        except AttributeError:
            c = Gdk.RGBA()
            c.red = c.green = c.blue = c.alpha = 1.0
        self.fn(cr, c, self.state)

    def set_state(self, state):
        self.state = state
        self.queue_draw()


def draw_panel_icon(cr, c, mode):
    cr.set_source_rgba(c.red, c.green, c.blue, c.alpha)
    cr.set_line_width(1.4)
    if mode == 'hidden':
        cr.set_dash([2.2, 2.2])
    cr.rectangle(1.7, 2.7, 12.6, 10.6)
    cr.stroke()
    cr.set_dash([])
    if mode == 'bottom':
        cr.rectangle(2.4, 9.0, 11.2, 3.6)
        cr.fill()
    elif mode == 'side':
        cr.rectangle(9.4, 3.4, 4.2, 9.2)
        cr.fill()


