    def save(self, overwrite, now=None, dest=None):
        """Zapis w tle: kadry są „zamrażane” w zadaniu, a pliki przetwarza osobny wątek, więc okno
        nie zamarza. Jeśli trwa to dłużej niż chwilę, pojawia się okno postępu."""
        if self.saving:
            return
        now = now or datetime.now()
        items, skip = [], 0
        for i, t in enumerate(self.thumbs, 1):
            crop = self.crop_of(t)
            if crop:
                items.append({'nr': i, 'path': t.path, 'crop': list(crop), 'group': t.group})
            else:
                skip += 1
        if not items:
            return self.toast('Żaden obraz nie ma kadru')
        job = {'overwrite': overwrite, 'scheme': '[nazwa]' if overwrite else self.scheme, 'now': now,
               'dest': dest, 'items': items, 'skip': skip,
               'general': list(self.general) if self.general else None,
               'groups': {str(g): c for g, c in self.groups.items()},
               'refs': {str(k): list(v) for k, v in self.refs.items()}}
        if self.sticky_kind == 'errors':
            self.errors = None
            self.drop_sticky()      # nowy zapis zastępuje stary raport błędów
        self.busy_begin(len(items), overwrite)
        threading.Thread(target=self.save_worker, args=(job,), daemon=True).start()

    def busy_begin(self, total, overwrite):
        self.saving = True
        self.save_prog = {'k': 0, 'total': total, 'name': '', 'phase': 'save', 'overwrite': overwrite}
        self.tv.set_can_target(False)       # myszka nie dociera do interfejsu, dopóki trwa zapis
        self.b_save.set_sensitive(False)
        self.b_as.set_sensitive(False)
        self.save_timer = GLib.timeout_add(SAVE_DELAY, self.save_dialog)
        self.upd_title()

    def busy_end(self):
        if self.save_timer:
            GLib.source_remove(self.save_timer)
            self.save_timer = 0
        d, self.save_dlg = self.save_dlg, None
        if d:
            d.force_close()
        self.saving = False
        self.save_prog = None
        self.tv.set_can_target(True)
        self.upd_title()

    def save_dialog(self):
        """Okno postępu — pojawia się dopiero, gdy zapis trwa dłużej niż SAVE_DELAY."""
        self.save_timer = 0
        if not self.saving or self.save_dlg:
            return GLib.SOURCE_REMOVE
        d = Adw.Dialog(follows_content_size=True)
        d.set_can_close(False)
        self.sv_title = Gtk.Label(css_classes=['title-2'], wrap=True)
        self.sv_bar = Gtk.ProgressBar(show_text=True, width_request=380)
        self.sv_file = dim('')
        self.sv_file.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        self.sv_file.set_max_width_chars(48)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                      margin_top=24, margin_bottom=24, margin_start=28, margin_end=28)
        for w in (self.sv_title, self.sv_bar, self.sv_file):
            col.append(w)
        d.set_child(col)
        self.save_dlg = d
        self.save_paint()
        d.present(self)
        return GLib.SOURCE_REMOVE

    def save_paint(self):
        p = self.save_prog
        if not p or not self.save_dlg:
            return
        thumbs = p['phase'] == 'thumbs'
        k, total = p['k'], p['total']
        if thumbs:
            self.sv_title.set_text('Odświeżanie miniatur…')
            self.sv_bar.set_text(f'Miniatura {k} z {total}')
        else:
            self.sv_title.set_text('Zastępowanie oryginałów…' if p['overwrite'] else 'Zapisywanie obrazów…')
            self.sv_bar.set_text(f'Obraz {k} z {total}')
        frac = ((k if thumbs else max(k - 1, 0)) / total) if total else 1.0
        self.sv_bar.set_fraction(min(1.0, max(0.0, frac)))
        self.sv_file.set_text(p['name'])

    def save_step(self, k, total, name):
        """Z wątku zapisu (przez idle_add): aktualnie przetwarzany obraz."""
        if self.saving and self.save_prog:
            self.save_prog.update(k=k, total=total, name=name)
            self.save_paint()
            self.upd_title()
        return GLib.SOURCE_REMOVE

    def save_worker(self, job):
        """Wątek zapisu — nie dotyka widgetów, do interfejsu trafiają tylko wiadomości przez idle_add."""
        res = {'done': 0, 'errors': [], 'items': [], 'outs': [], 'abort': None}
        try:
            self.save_run(job, res)
        except Exception as e:      # nieprzewidziany błąd nie może zostawić okna w trybie „zapisywania”
            res['errors'].append({'path': '', 'why': f'Nieoczekiwany błąd: {err_text(e)}'})
        GLib.idle_add(self.save_finished, job, res)

    def save_run(self, job, res):
        overwrite, scheme, now, dest = job['overwrite'], job['scheme'], job['now'], job['dest']
        if overwrite:
            undo_clear()
            try:
                os.makedirs(UNDO_DIR, exist_ok=True)
            except OSError as e:
                res['abort'] = f'Nie można utworzyć kopii zapasowej ({err_text(e)}) — nic nie zmieniono'
                return
        total = len(job['items'])
        for k, it in enumerate(job['items'], 1):
            p = it['path']
            GLib.idle_add(self.save_step, k, total, os.path.basename(p))
            x, y, w, h = it['crop']
            backup, out, stage = None, None, 'odczyt obrazu'
            try:
                pix = load(p)
                pw, ph = pix.get_width(), pix.get_height()
                if x >= pw or y >= ph:
                    res['errors'].append({'path': p, 'why': f'kadr leży poza obrazem ({pw}×{ph} px)'})
                    continue
                sub = pix.new_subpixbuf(x, y, min(w, pw - x), min(h, ph - y))
                name, fmt = out_name(p, scheme, now, it['nr'])
                out = os.path.join(dest or save_dir(p), name)
                if overwrite and out == p:
                    # kopia oryginału przed nadpisaniem — bez niej nic nie nadpisujemy
                    stage = 'kopia zapasowa oryginału'
                    backup = os.path.join(UNDO_DIR, f'{len(res["items"])}.bak')
                    shutil.copy2(p, backup)
                else:
                    # kopia nigdy nie nadpisuje istniejącego pliku (w tym oryginału)
                    out = unique(out)
                stage = 'zapis pliku'
                opts = (['quality'], ['95']) if fmt == 'jpeg' else ([], [])
                try:
                    sub.savev(out, fmt, *opts)
                except GLib.Error:
                    if backup:
                        shutil.copy2(backup, p)
                    raise
            except (GLib.Error, OSError) as e:
                res['errors'].append({'path': p, 'why': f'{stage}: {err_text(e)}'})
                continue
            res['done'] += 1
            if overwrite:
                res['items'].append({'orig': p, 'backup': backup, 'out': out, 'group': it['group']})
            else:
                res['outs'].append(out)

    def save_finished(self, job, res):
        """Wątek skończył: zapisujemy manifest cofania, czyścimy kadry (po zastąpieniu) i odświeżamy
        miniatury po jednej na klatkę (też bez zamrażania)."""
        if res['abort']:
            self.undo_m = undo_load()
            self.upd_undo()
            self.busy_end()
            self.sync()
            self.toast(res['abort'])
            return GLib.SOURCE_REMOVE
        overwrite, done = job['overwrite'], res['done']
        if overwrite:
            if res['items']:
                try:
                    with open(UNDO_MAN, 'w') as f:
                        json.dump({'crop': job['general'], 'groups': job['groups'], 'refs': job['refs'],
                                   'items': res['items']}, f)
                except OSError:
                    pass
                self.undo_m = undo_load()
            else:
                undo_clear()
                self.undo_m = None
            self.upd_undo()
        if done:
            self.dirty = False
        changed = set()
        if overwrite and done:
            # oryginały są już przycięte — te same kadry drugi raz nie miałyby sensu
            self.hist_reset()
            self.general = None
            self.groups = {}
            self.refs = {}
            for t in self.thumbs:
                t.group = None
            changed = {it['orig'] for it in res['items'] if it['backup']}
        todo = [t for t in self.thumbs if t.path in changed]
        if not todo:
            self.save_done(job, res)
            return GLib.SOURCE_REMOVE
        self.save_prog.update(phase='thumbs', k=0, total=len(todo), name='')
        self.save_paint()
        self.upd_title()
        self.reload_thumbs(todo, lambda: self.save_done(job, res))
        return GLib.SOURCE_REMOVE

    def reload_thumbs(self, todo, done):
        """Odświeża miniatury po zmianie plików — po jednej na klatkę, żeby okno nie zamarzało."""
        todo = list(todo)
        n = len(todo)

        def tick():
            if todo:
                t = todo.pop(0)
                if self.save_prog:
                    self.save_prog.update(k=n - len(todo), name=t.name)
                    self.save_paint()
                    self.upd_title()
                try:
                    t.load()
                except GLib.Error:
                    pass
                return GLib.SOURCE_CONTINUE
            done()
            return GLib.SOURCE_REMOVE
        GLib.idle_add(tick)

    def save_done(self, job, res):
        self.busy_end()
        if job['overwrite'] and res['done'] and self.thumbs:
            self.show(self.cur or self.thumbs[0])
        else:
            self.sync()
        self.report_save(job, res)

    def report_save(self, job, res):
        done, errs, outs, skip = res['done'], res['errors'], res['outs'], job['skip']
        msg = f'Zapisano: {done}' + (f', błędy: {len(errs)}' if errs else '') + (f', bez kadru: {skip}' if skip else '')
        if errs:
            # toast z błędami zostaje do otwarcia nowych obrazów; „Szczegóły” pokazują, co i dlaczego zawiodło
            self.errors = {'title': 'Błędy zapisu', 'msg': msg, 'errs': errs, 'outs': outs,
                           'intro': f'Zapisano: {done}. Tych obrazów nie udało się przyciąć i zapisać:'}
            self.show_sticky('errors')
        elif outs:
            self.toast(msg, self.reveal_label(outs), lambda: self.reveal_files(outs), 10)
        else:
            self.toast(msg)

    def undo(self, _):
        m = self.undo_m
        if not m or self.saving:
            return
        ok, errs = 0, []
        for it in m['items']:
            try:
                if it['backup']:
                    shutil.copy2(it['backup'], it['orig'])
                elif os.path.exists(it['out']):
                    os.remove(it['out'])  # plik utworzony obok oryginału (np. PNG)
                ok += 1
            except OSError as e:
                errs.append({'path': it['orig'], 'why': err_text(e)})
        if not errs:
            undo_clear()
            self.undo_m = None
        self.upd_undo()
        if ok and not self.has_crops():
            # przywracamy kadr ogólny, grupy (#N), wzorce kadrów i przynależność obrazów do grup
            self.hist_reset()
            gs = parse_groups(m.get('groups'))
            self.general = m['crop'] if valid_crop(m.get('crop')) else None
            self.groups = gs
            self.refs = parse_refs(m.get('refs'))
            gm = {it['orig']: it.get('group') for it in m['items']}
            for t in self.thumbs:
                g = gm.get(t.path)
                t.group = g if g in gs else None
            self.gc()
            if self.has_crops():
                self.dirty = True
        for t in self.thumbs:
            try:
                t.load()
            except GLib.Error:
                pass
        if self.cur:
            self.show(self.cur)
        else:
            self.sync()
        msg = f'Przywrócono: {ok}' + (f', błędy: {len(errs)}' if errs else '')
        if errs:
            self.errors = {'title': 'Błędy przywracania', 'msg': msg, 'errs': errs, 'outs': [],
                           'intro': f'Przywrócono: {ok}. Tych plików nie udało się przywrócić '
                                    '(kopie zapasowe zostają — można spróbować ponownie):'}
            self.show_sticky('errors')
        else:
            self.toast(msg)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id='local.Kadr', flags=Gio.ApplicationFlags.HANDLES_OPEN)

    def do_startup(self):
        Adw.Application.do_startup(self)
        Gtk.Window.set_default_icon_name('local.Kadr')
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        try:
            # suwaki nakładkowe (cienkie, nie zabierają miejsca) — niezależnie od ustawień systemu
            Gtk.Settings.get_default().set_property('gtk-overlay-scrolling', True)
        except Exception:
            pass
        p = Gtk.CssProvider()
        p.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), p,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        st = load_state()
        keep = set(st['images'])
        if st['cleared']:
            keep |= set(st['cleared']['paths'])
        purge_pasted(keep)

    def win(self):
        return self.get_active_window() or Win(self)

    def do_activate(self):
        self.win().present()

    def do_open(self, files, n, hint):
        w = self.win()
        w.add_files([f.get_path() for f in files if f.get_path()])
        w.present()


sys.exit(App().run(sys.argv))
