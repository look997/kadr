def draw_copy_icon(cr, c, done):
    """Ikona „kopiuj polecenie”: dwie kartki ze znakiem zachęty (>_); po skopiowaniu zielony ptaszek."""
    cr.set_line_width(1.4)
    cr.set_line_join(cairo.LineJoin.ROUND)
    cr.set_line_cap(cairo.LineCap.ROUND)
    if done:
        cr.set_source_rgb(*GREEN)
        cr.move_to(2.5, 8.5)
        cr.line_to(6.3, 12.3)
        cr.line_to(13.5, 3.7)
