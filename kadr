        elif multi and active:
            tip = f'Wyłącz tryb indywidualny dla zaznaczonych obrazów ({len(ts)}) — wrócą do kadru ogólnego.'
        elif multi:
            tip = f'Nadaj zaznaczonym obrazom ({len(ts)}) wspólny, osobny kadr (nowy #N).'
        elif active:
            tip = f'Wyłącz tryb indywidualny (#{ts[0].group}) — obraz wróci do kadru ogólnego.'
        elif len(self.selected) >= 2:
            tip = ('Tryb indywidualny: osobny kadr tylko dla tego obrazu.\n'
                   'Ten obraz nie należy do zaznaczenia, więc dotyczy tylko jego — zaznaczenie zostaje bez zmian.')
        else:
            tip = ('Tryb indywidualny: osobny kadr tylko dla tego obrazu.\n'
                   'Zaznacz kilka miniatur (Ctrl/Shift+klik), żeby nadać im wspólny osobny kadr.')
        self.b_ind.set_tooltip_text(tip)

    def upd_count(self):
        """Pasek nad miniaturami: liczba obrazów, zaznaczenie, postęp ładowania i podpowiedź nawigacji."""
        n, k = len(self.thumbs), len(self.selected)
        if self.loading:
            txt = f'Ładowanie obrazów: {self.load_done}/{self.load_total}…'
            if k:
                txt += f' · zaznaczone: {k}'
        else:
            txt = f'Obrazy: {n}' + (f' · zaznaczone: {k}' if k else '')
            if n > 1:
                if self.mode == 'side':
                    txt += ' · ' + NAV_HINT[0].upper() + NAV_HINT[1:]
                else:
                    txt += ' · ' + NAV_HINT
        self.count.set_text(txt)
        big = str(len(self.thumbs) + len(self.queue))
        self.count_sz.set_text(f'Obrazy: {big} · zaznaczone: {big} · {NAV_HINT[0].upper() + NAV_HINT[1:]}')

    def upd_title(self):
        cur, n = self.cur, len(self.thumbs)
        parts = []
        if cur:
            parts.append(f'{cur.name} ({self.thumbs.index(cur) + 1}/{n})')
        if self.loading:
            parts.append(f'ładowanie {self.load_done}/{self.load_total}')
        p = self.save_prog
        if p:
            if p['phase'] == 'thumbs':
                parts.append(f'odświeżanie miniatur {p["k"]}/{p["total"]}')
            else:
                parts.append(f'zapisywanie {p["k"]}/{p["total"]}')
        self.wtitle.set_subtitle(' · '.join(parts))

    def upd_loading(self):
        """Lekka aktualizacja wskaźników ładowania (wywoływana po każdym załadowanym obrazie)."""
        a = self.area
        if self.loading:
            status = f'Ładowanie obrazów… {self.load_done}/{self.load_total}'
        elif self.restoring:
            status = 'Przywracanie sesji…'
        else:
            status = None
        if a.pix is not None:
            status = None
        if a.status != status:
            a.status = status
            a.queue_draw()
        self.spinner.set_visible(self.loading)
        self.spinner.set_spinning(self.loading)
        self.extra.set_visible(bool(self.thumbs) or self.loading)
        self.upd_count()
        self.upd_title()

    # --- dodawanie obrazów: przycisk, drop, schowek ---
    def open_files(self, *_):
        f = Gtk.FileFilter()
        f.set_name('Obrazy')
        for fm in FORMATS:
            for m in fm.get_mime_types():
                f.add_mime_type(m)
        st = Gio.ListStore.new(Gtk.FileFilter)
        st.append(f)
        d = Gtk.FileDialog(title='Wybierz obrazy', filters=st, default_filter=f)
        d.open_multiple(self, None, self.on_files)

    def on_files(self, d, res):
        try:
            files = d.open_multiple_finish(res)
        except GLib.Error:
            return
        self.add_files([files.get_item(i).get_path() for i in range(files.get_n_items())])

    def on_drop(self, target, value, x, y):
        try:
            paths = [f.get_path() for f in value.get_files() if f.get_path()]
        except Exception:
            return False
        if not paths:
            return False
        self.add_files(paths)
        return True

    def paste(self):
        cb = self.get_clipboard()
        fm = cb.get_formats()
        if fm.contain_gtype(Gdk.FileList.__gtype__):
            cb.read_value_async(Gdk.FileList.__gtype__, GLib.PRIORITY_DEFAULT, None, self.on_paste_files)
        elif fm.contain_gtype(Gdk.Texture.__gtype__):
            cb.read_texture_async(None, self.on_paste_tex)
        else:
            self.toast('W schowku nie ma obrazów ani plików')

    def on_paste_files(self, cb, res):
        try:
            v = cb.read_value_finish(res)
            paths = [f.get_path() for f in v.get_files() if f.get_path()]
        except Exception:
            return self.toast('Nie można wkleić ze schowka')
        if paths:
            self.add_files(paths)
        else:
            self.toast('W schowku nie ma plików lokalnych')

    def on_paste_tex(self, cb, res):
        try:
            tex = cb.read_texture_finish(res)
            os.makedirs(PASTE_DIR, exist_ok=True)
            path = unique(os.path.join(PASTE_DIR, 'wklejony_' + datetime.now().strftime('%Y%m%d-%H%M%S') + '.png'))
            if not tex.save_to_png(path):
                raise GLib.Error('zapis nieudany')
        except (GLib.Error, OSError, AttributeError):
            return self.toast('Nie można wkleić obrazu ze schowka')
        self.add_files([path])

    # --- ładowanie obrazów po jednym, w tle ---
    def add_files(self, paths, first=None, groups=None, front=False):
        """Kolejkuje obrazy do załadowania (duplikaty po ścieżce są pomijane). Ładują się po jednym."""
        if self.saving:
            return self.toast('Trwa zapisywanie — dodaj obrazy, gdy się skończy')
        have = {t.path for t in self.thumbs} | set(self.queue)
        new = []
        for p in dict.fromkeys(paths):
            if p in have:
                self.load_dup += 1
            else:
                new.append(p)
        if not new:
            if not self.loading:
                self.report_load()
            return
        self.forget_cleared()   # nowe obrazy — propozycja przywrócenia starej listy i raport błędów wygasają
        if groups:
            self.load_groups.update({p: g for p, g in groups.items() if p in new})
        if first:
            self.load_first = first
        if front:
            self.queue[:0] = new
        else:
            self.queue.extend(new)
        self.load_total += len(new)
        if self.has_crops():
            self.dirty = True  # nowe obrazy nie mają jeszcze zastosowanego kadru
        self.start_load()

    def start_load(self):
        if self.load_id:
            self.upd_loading()
            return
        self.loading = True
        self.load_id = GLib.idle_add(self.load_tick)
        self.sync()

    def load_tick(self):
        if not self.queue:
            self.finish_load()
            return GLib.SOURCE_REMOVE
        p = self.queue.pop(0)
        self.load_done += 1
        try:
            t = Thumb(p, self.info_for)
        except (GLib.Error, TypeError):
            self.load_bad.append(os.path.basename(p))
            self.load_groups.pop(p, None)
        else:
            g = self.load_groups.pop(p, None)
            t.group = g if g in self.groups else None
            self.add_thumb(t)
            self.place_last()
            if self.cur is None and (self.load_first is None or p == self.load_first):
                self.show(t)
        if not self.queue:
            self.finish_load()
            return GLib.SOURCE_REMOVE
        self.upd_loading()
        return GLib.SOURCE_CONTINUE

    def finish_load(self):
        self.load_id = 0
        self.loading = False
        self.load_total = self.load_done = 0
        self.load_first = None
        self.load_groups = {}
        self.gc()
        if self.cur is None and self.thumbs:
            self.show(self.thumbs[0])
        else:
            self.sync()
        self.report_load()

    def report_load(self):
        msgs = []
        if self.load_bad:
            msgs.append('Nie można otworzyć: ' + ', '.join(self.load_bad[:3]) + ('…' if len(self.load_bad) > 3 else ''))
        if self.load_dup:
            msgs.append(f'Pominięto duplikaty: {self.load_dup}')
        self.load_bad, self.load_dup = [], 0
        if msgs:
            self.toast(' · '.join(msgs))

    def cancel_load(self):
        if self.load_id:
            GLib.source_remove(self.load_id)
            self.load_id = 0
        self.queue = []
        self.loading = False
        self.load_total = self.load_done = 0
        self.load_first = None
        self.load_groups = {}
        self.load_bad, self.load_dup = [], 0

    def clear_all(self, _):
        if not self.thumbs and not self.queue:
            return
        self.forget_cleared()
        img_groups = {t.path: t.group for t in self.thumbs if t.group}
        img_groups.update(self.load_groups)
        self.cleared = {'paths': [t.path for t in self.thumbs] + list(self.queue),
                        'current': self.cur.path if self.cur else self.load_first,
                        'groups': dict(self.groups), 'refs': dict(self.refs),
                        'img_groups': img_groups,
                        'dirty': self.dirty}
        self.cancel_load()
        self.hist_reset()
        self.view0 = None
        for t in self.thumbs:
            if t.cell.get_parent() is self.tgrid:
                self.tgrid.remove(t.cell)
        self.thumbs, self.cur, self.anchor = [], None, None
        self.selected = set()
        self.gc()
        self.reflow(True)
        self.area.clear()
        self.sync()
        self.show_sticky('clear')

    def add_thumb(self, t):
        g = Gtk.GestureClick()
        g.set_button(1)
        g.connect('pressed', lambda gs, n, x, y: self.on_thumb_click(t, gs.get_current_event_state()))
        t.add_controller(g)
        mg = Gtk.GestureClick()
        mg.set_button(2)
        mg.connect('released', lambda gs, n, x, y: self.reveal_files([t.path]))
        t.add_controller(mg)
        ov = Gtk.Overlay(child=t)
        x = Gtk.Button(icon_name='window-close-symbolic', halign=Gtk.Align.END, valign=Gtk.Align.START,
                       tooltip_text='Usuń z listy', css_classes=['circular', 'osd'], visible=False)
        x.connect('clicked', lambda b: self.drop(t))
        ov.add_overlay(x)
        t.cell, t.xbtn = ov, x
        self.style_cell(t, self.mode == 'side')
        # krzyżyk widoczny tylko po najechaniu na miniaturę
        mc = Gtk.EventControllerMotion()
        mc.connect('notify::contains-pointer',
                   lambda c, p: x.set_visible(c.get_property('contains-pointer')))
        ov.add_controller(mc)
        self.thumbs.append(t)

    # --- zaznaczanie miniatur ---
    def set_selected(self, s):
        self.selected = set(s)
        self.sync()

    def pick(self, t):
        if t is self.cur:
            self.sync()
        else:
            self.show(t)

    def on_thumb_click(self, t, state):
        """Zwykłe kliknięcie przełącza obraz; Ctrl/Shift zarządzają zaznaczeniem (które zostaje przy przełączaniu)."""
        ctrl = bool(state & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(state & Gdk.ModifierType.SHIFT_MASK)
        if shift:
            base = self.anchor if self.anchor in self.thumbs else (self.cur or t)
            a, b = sorted((self.thumbs.index(base), self.thumbs.index(t)))
            rng = set(self.thumbs[a:b + 1])
            self.selected = (self.selected | rng) if ctrl else rng
            self.pick(t)
            self.anchor = base
        elif ctrl:
            if not self.selected and self.cur:
                self.selected = {self.cur}
            if t in self.selected:
                self.selected.discard(t)
                self.sync()
            else:
                self.selected.add(t)
                self.pick(t)
            self.anchor = t
        else:
            self.anchor = t
            self.pick(t)

    def show(self, t):
        """Pokazuje obraz w widoku kadrowania (kadr zależy od trybu indywidualnego obrazu)."""
        try:
            pix = load(t.path)
        except GLib.Error:
            return self.toast(f'Nie można otworzyć: {os.path.basename(t.path)}')
        self.cur = t
        self.anchor = t
        self.area.set_pix(pix)
        v, self.view0 = self.view0, None
        if v and v['path'] == t.path:
            self.area.set_view(v['zoom'], v['cx'], v['cy'])
        self.sync()
        GLib.idle_add(self.reveal, t)

    def drop(self, t):
        i = self.thumbs.index(t)
        if t.cell.get_parent() is self.tgrid:
            self.tgrid.remove(t.cell)
        self.thumbs.remove(t)
        self.selected.discard(t)
        if self.anchor is t:
            self.anchor = None
        self.gc()
        self.reflow(True)
        if t is self.cur:
            if self.thumbs:
                return self.show(self.thumbs[min(i, len(self.thumbs) - 1)])
            self.cur = None
            self.area.clear()
        self.sync()

    def on_spin(self, sp=None, key=None):
        if self.lock:
            return
        mw, mh = self.maxdim
        x, y, w, h = (int(self.spins[k].get_value()) for k in 'xywh')
        x, y = min(x, mw - 1), min(y, mh - 1)
        self.hist_push('spin')
        self.store([x, y, max(1, min(w, mw - x)), max(1, min(h, mh - y))])
        self.dirty = True
        self.sync()
        if key:
            self.area.loupe_edge(key)

    def info_text(self, t):
        iw, ih = t.dims
        c = self.crop_of(t)
        txt = f'Obraz: {iw}×{ih} px'
        if t.group:
            txt += f' · kadr indywidualny #{t.group}'
        if c and self.ratio(t):
            txt += ' · kadr przeskalowany pod ten obraz'
        if c and (c[0] >= iw or c[1] >= ih):
            txt += ' · kadr poza obrazem'
        return txt

    def sync(self):
        a, n, cur = self.area, len(self.thumbs), self.cur
        # kadr i kolor widoku zależą od tego, czy aktywny obraz ma tryb indywidualny
        a.sel = self.crop_of(cur) if cur else self.general
        a.color = GREEN if cur and cur.group else ACCENT
        a.label = self.tag_of(cur) if cur else None
        s = a.sel
        self.lock = True
        self.maxdim = ((max(t.dims[0] for t in self.thumbs), max(t.dims[1] for t in self.thumbs))
                       if n else (100000, 100000))
        for k, v in (('x', self.maxdim[0]), ('y', self.maxdim[1]),
                     ('w', self.maxdim[0]), ('h', self.maxdim[1])):
            self.spins[k].set_range(0, v)
        for k, v in zip('xywh', s or [0, 0, *a.size]):
            self.spins[k].set_value(v)
        self.lock = False

        # sizerki: różne opisy obrazów z listy (najdłuższe z nich) — wysokość pola = najwyższy opis
        # przy bieżącej szerokości panelu, więc nic nie skacze przy przełączaniu obrazów
        info_all = [self.info_text(t) for t in self.thumbs]
        self.sync_info_sz(sorted(set(info_all), key=lambda s: (-len(s), s))[:8])
        if cur:
            txt = self.info_text(cur)
            self.info.set_text(txt)
            self.info.set_tooltip_text(txt)
        else:
            self.info.set_text('')
            self.info.set_tooltip_text(None)

        can = (bool(self.thumbs) and not self.loading and not self.saving
               and any(self.crop_of(t) for t in self.thumbs))
        self.b_save.set_sensitive(can)
        self.b_as.set_sensitive(can)
        self.bgrip.set_visible(self.mode == 'bottom' and n > 0)
        self.upd_desel()
        a.queue_draw()
        for t in self.thumbs:
            t.current = t is cur
            t.selected = t in self.selected
            t.queue_draw()
            tip = t.name + '\nŚrodkowy przycisk myszy — pokaż w menedżerze plików' + ('\n% — kadr przeskalowany pod ten obraz'
                            if self.raw_of(t) and self.ratio(t) else '')
            if tip != t.tip:
                t.tip = tip
                t.set_tooltip_text(tip)
        i = self.thumbs.index(cur) if cur in self.thumbs else -1
        self.b_prev.set_sensitive(i > 0)
        self.b_next.set_sensitive(0 <= i < n - 1)
        self.upd_indiv()
        self.upd_tools()
        self.upd_loading()
        self.persist_soon()

    # --- pokazywanie zapisanych plików w menedżerze plików ---
    def reveal_label(self, paths, saved=False):
        """Etykieta przycisku: przy kilku folderach mówi, ile okien menedżera plików się otworzy."""
        n = len({os.path.dirname(p) for p in paths})
        return ('Pokaż zapisane ' if saved else 'Pokaż ') + ('w folderze' if n <= 1 else f'w folderach ({n} {okna(n)})')

    def reveal_files(self, paths):
        """Jedno okno menedżera plików na folder. Jeśli menedżer to potrafi, zaznacza w nim wszystkie
        zapisane pliki z tego folderu; w przeciwnym razie (np. starszy Nemo, który otwierał osobne
        okno na każdy plik) zaznacza pierwszy z nich."""
        groups = {}
        for p in paths:
            if os.path.exists(p):
                groups.setdefault(os.path.dirname(p), []).append(p)
        if not groups:
            return self.toast('Zapisane pliki już nie istnieją')
        every = fm_selects_all()

        def fallback(folder):
            Gtk.FileLauncher.new(Gio.File.new_for_path(folder)).launch(self, None, lambda *_: None)

        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error:
            bus = None
        for folder, files in groups.items():
            if bus is None:
                fallback(folder)
                continue
            uris = [Gio.File.new_for_path(f).get_uri() for f in (files if every else files[:1])]

            def done(b, res, folder=folder):
                try:
                    b.call_finish(res)
                except GLib.Error:
                    fallback(folder)

            bus.call('org.freedesktop.FileManager1', '/org/freedesktop/FileManager1',
                     'org.freedesktop.FileManager1', 'ShowItems', GLib.Variant('(ass)', (uris, '')),
                     None, Gio.DBusCallFlags.NONE, -1, None, done)
        if not every and any(len(v) > 1 for v in groups.values()):
            self.toast('Ten menedżer plików potrafi zaznaczyć w oknie tylko jeden plik — '
                       'zaznaczono pierwszy z zapisanych.', timeout=6)

    # --- polecenia: opis zmian dla każdego obrazu (do skopiowania) ---
    def commands_text(self, scheme, now, dest):
        """Same fakty: co przyciąć, jakim kadrem i do jakiej nazwy — osobno dla każdego obrazu."""
        lines, n = [], 0
        for i, t in enumerate(self.thumbs, 1):
            crop = self.crop_of(t)
            if not crop:
                continue
            x, y, w, h = crop
            iw, ih = t.dims
            if x >= iw or y >= ih:
                continue    # kadr poza obrazem — tak samo jak przy zapisie
            w, h = min(w, iw - x), min(h, ih - y)
            name, _fmt = out_name(t.path, scheme, now, i)
            out = unique(os.path.join(dest or save_dir(t.path), name))
            n += 1
            note = '; kadr przeskalowany pod ten obraz' if self.ratio(t) else ''
            lines.append(f'{n}. Przytnij: {t.path}')
            lines.append(f'   Kadr: x={x}, y={y}, szerokość={w}, wysokość={h} px '
                         f'(od lewego górnego rogu; obraz ma {iw}×{ih} px{note})')
            lines.append(f'   Zapisz jako: {out}')
            lines.append('')
        return '\n'.join(lines).strip()

    # --- zapis ---
    def quick_save(self, g, n, x, y):
        """Środkowy przycisk na „Zapisz jako”: zapis od razu, bez dialogu i potwierdzenia."""
